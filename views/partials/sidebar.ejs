<!-- Main -->
<div class="mt-10 flex flex-col lg:flex-row items-start gap-6 px-2 md:px-10">

    <!-- Sidebar -->
    <div class="border border-gray-200 shadow-lg rounded-xl p-5 w-full lg:w-1/5 xl:w-1/5 bg-white 
    lg:sticky lg:top-5 lg:h-[90vh] lg:overflow-y-auto">
        <h2 class="text-xl font-semibold pb-3 border-b text-gray-800">📊 Dashboard</h2>
        <ul class="mt-4 space-y-2 text-gray-700">

            <li>
                <a href="/users"
                    class="flex items-center justify-between p-3 rounded-lg transition hover:bg-blue-100 hover:text-blue-600 border-l-4 border-transparent hover:border-blue-500">
                    <div class="flex items-center gap-3">
                        👤 <span>Users</span>
                    </div>
                    <span
                        class="bg-blue-600 text-white text-xs font-bold w-5 h-5 flex items-center justify-center rounded-full">
                        <%=userCount %>
                    </span>
                </a>
            </li>

            <li>
                <a href="/complaints"
                    class="flex items-center justify-between p-3 rounded-lg transition hover:bg-red-100 hover:text-red-600 border-l-4 border-transparent hover:border-red-500">
                    <div class="flex items-center gap-3">
                        📝 <span>Complaints</span>
                    </div>
                    <span
                        class="bg-red-600 text-white text-xs font-bold w-5 h-5 flex items-center justify-center rounded-full">
                        <%=complaintCount %>
                    </span>
                </a>
            </li>

            <li>
                <a href="/cities"
                    class="flex items-center justify-between p-3 rounded-lg transition hover:bg-green-100 hover:text-green-600 border-l-4 border-transparent hover:border-green-500">
                    <div class="flex items-center gap-3">
                        🌆 <span>Cities</span>
                    </div>
                    <span
                        class="bg-green-600 text-white text-xs font-bold w-5 h-5 flex items-center justify-center rounded-full">
                        <%= cityCount %>
                    </span>
                </a>
            </li>

            <li>
                <a href="/categories"
                    class="flex items-center justify-between p-3 rounded-lg transition hover:bg-purple-100 hover:text-purple-600 border-l-4 border-transparent hover:border-purple-500">
                    <div class="flex items-center gap-3">
                        📋 <span>Categories</span>
                    </div>
                    <span
                        class="bg-purple-600 text-white text-xs font-bold w-5 h-5 flex items-center justify-center rounded-full">
                        <%= categoryCount %>
                    </span>
                </a>
            </li>

            <li>
                <a href="/products"
                    class="flex items-center justify-between p-3 rounded-lg transition hover:bg-yellow-100 hover:text-yellow-600 border-l-4 border-transparent hover:border-yellow-500">
                    <div class="flex items-center gap-3">
                        📦 <span>Products</span>
                    </div>
                    <span
                        class="bg-yellow-600 text-white text-xs font-bold w-5 h-5 flex items-center justify-center rounded-full">
                        <%=productCount %>
                    </span>
                </a>
            </li>

            <li>
                <a href="/products/old-history"
                    class="flex items-center justify-between p-3 rounded-lg transition hover:bg-gray-200 hover:text-gray-800 border-l-4 border-transparent hover:border-gray-500">
                    <div class="flex items-center gap-3">
                        📜 <span>Products History</span>
                    </div>
                    <span
                        class="bg-gray-600 text-white text-xs font-bold w-5 h-5 flex items-center justify-center rounded-full">
                        <%=oldProductCount %>
                    </span>
                </a>
            </li>

        </ul>
    </div>