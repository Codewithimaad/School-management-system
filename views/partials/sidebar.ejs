<div id="sidebar"
    class="sidebar w-72 md:w-80 z-50 overflow-y-auto fixed max-h-screen h-full sm:h-full top-0 left-0 bg-white/50 backdrop-blur-lg p-3 md:p-7 shadow-2xl rounded-3xl border border-blue-100 transform -translate-x-full lg:translate-x-0">
    <!-- Close Button inside Sidebar -->
    <button id="sidebarClose"
        class="absolute mt-3 lg:hidden top-5 right-5 p-2 bg-white rounded-full shadow-lg hover:shadow-xl hover:bg-red-50 transition-all duration-300 hover-scale">
        <i class="fas fa-times text-2xl text-gray-600 hover:text-red-600"></i>
    </button>

    <div class="flex items-center space-x-4 mb-10">
        <img src="/images/logo.png" alt="Logo" class="w-16 h-16 drop-shadow-lg animate-pulse">
        <span class="text-blue-700 text-1xl md:text-3xl font-extrabold tracking-wide">Luminous</span>
    </div>

    <ul class="space-y-4">
        <% if (userRole==='admin' ) { %>
            <!-- Dashboard -->
            <li>
                <a href="/dashboard"
                    class="flex items-center justify-between w-full text-blue-700 p-3 rounded-2xl bg-gradient-to-r from-blue-50 to-blue-100 hover:from-blue-100 hover:to-blue-200 transition duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-1">
                    <div class="flex items-center">
                        <i class='fas fa-th-large text-lg hover-scale'></i>
                        <span class="ml-5 font-semibold text-base">Dashboard</span>
                    </div>
                </a>
            </li>
            <% } %>


                <% if(userRole==='admin' ){ %>
                    <!-- Students Dropdown -->
                    <li class="relative">
                        <button onclick="toggleDropdown('studentsDropdown', 'studentsIcon')"
                            class="flex items-center justify-between w-full text-blue-700 p-3 rounded-2xl hover:bg-blue-100 transition duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-1">
                            <div class="flex items-center">
                                <i class="fas fa-user-graduate text-lg hover-scale"></i>
                                <span class="ml-5 font-semibold text-base">Students</span>
                            </div>
                            <i id="studentsIcon" class='fas fa-chevron-down ml-auto transition-transform'></i>
                        </button>

                        <ul id="studentsDropdown"
                            class="hidden bg-blue-50 rounded-xl mt-3 shadow-lg p-3 transition-all duration-300">
                            <li><a href="/dashboard/student/add"
                                    class="block text-base px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">Add
                                    Student</a></li>
                            <li><a href="/dashboard/student/reports"
                                    class="block text-base px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">Student
                                    Reports</a></li>
                        </ul>
                    </li>
                    <%} %>

                        <% if(userRole==='admin' ){ %>
                            <!-- Teachers Dropdown -->
                            <li class="relative">
                                <button onclick="toggleDropdown('teachersDropdown', 'teachersIcon')"
                                    class="flex items-center justify-between w-full text-blue-700 p-3 rounded-2xl hover:bg-blue-100 transition duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-1">
                                    <div class="flex items-center">
                                        <i class="fas fa-chalkboard-teacher text-lg hover-scale"></i>
                                        <span class="ml-5 font-semibold text-base">Teachers</span>
                                    </div>
                                    <i id="teachersIcon" class='fas fa-chevron-down ml-auto transition-transform'></i>
                                </button>

                                <ul id="teachersDropdown"
                                    class="hidden bg-blue-50 rounded-xl mt-3 shadow-lg p-3 transition-all duration-300">
                                    <li><a href="/dashboard/teacher/add"
                                            class="block px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">Add
                                            Teacher</a></li>
                                    <li><a href="/dashboard/teacher/reports"
                                            class="block px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">Teacher
                                            Reports</a></li>
                                </ul>
                            </li>
                            <%} %>

                                <% if(userRole==='admin' ){ %>
                                    <!-- Classes Dropdown -->
                                    <li class="relative">
                                        <button onclick="toggleDropdown('classesDropdown', 'classesIcon')"
                                            class="flex items-center justify-between w-full text-blue-700 p-3 rounded-2xl hover:bg-blue-100 transition duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-1">
                                            <div class="flex items-center">
                                                <i class="fas fa-chalkboard text-lg hover-scale"></i>
                                                <span class="ml-5 font-semibold text-base">Classes</span>
                                            </div>
                                            <i id="classesIcon"
                                                class='fas fa-chevron-down ml-auto transition-transform'></i>
                                        </button>

                                        <ul id="classesDropdown"
                                            class="hidden bg-blue-50 rounded-xl mt-3 shadow-lg p-3 transition-all duration-300">
                                            <li><a href="/dashboard/class/add"
                                                    class="block px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">Add
                                                    Class</a></li>
                                            <li><a href="/dashboard/class/reports"
                                                    class="block px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">Class
                                                    Reports</a></li>
                                        </ul>
                                    </li>
                                    <%} %>


                                        <!-- Fee Dropdown -->
                                        <li class="relative">
                                            <button onclick="toggleDropdown('feeDropdown', 'feeIcon')"
                                                class="flex items-center justify-between w-full text-blue-700 p-3 rounded-2xl hover:bg-blue-100 transition duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-1">
                                                <div class="flex items-center">
                                                    <i class="fas fa-money-bill-wave text-lg hover-scale"></i>
                                                    <span class="ml-5 font-semibold text-base">Fees</span>
                                                </div>
                                                <i id="feeIcon"
                                                    class='fas fa-chevron-down ml-auto transition-transform'></i>
                                            </button>

                                            <ul id="feeDropdown"
                                                class="hidden bg-blue-50 rounded-xl mt-3 shadow-lg p-3 transition-all duration-300">
                                                <% if(userRole==='admin' ){ %>
                                                    <li><a href="/dashboard/fee/add"
                                                            class="block px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">Add
                                                            Fee</a></li>
                                                    <li><a href="/dashboard/fee/reports"
                                                            class="block px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">Fee
                                                            Reports</a></li>
                                                    <%} %>

                                                        <% if(userRole==='student' ){ %>

                                                            <li><a href="/dashboard/check-fee"
                                                                    class="block px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">Check
                                                                    Fee</a></li>
                                                            <%} %>

                                            </ul>
                                        </li>

                                        <% if(userRole==='teacher' || userRole==='student' ){ %>
                                            <!-- Attendance Dropdown -->
                                            <li class="relative">
                                                <button onclick="toggleDropdown('attendanceDropdown', 'attendanceIcon')"
                                                    class="flex items-center justify-between w-full text-blue-700 p-3 rounded-2xl hover:bg-blue-100 transition duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-1">
                                                    <div class="flex items-center">
                                                        <i class="fas fa-clipboard-check text-lg hover-scale"></i>
                                                        <span class="ml-5 font-semibold text-base">Attendance</span>
                                                    </div>
                                                    <i id="attendanceIcon"
                                                        class='fas fa-chevron-down ml-auto transition-transform'></i>
                                                </button>

                                                <ul id="attendanceDropdown"
                                                    class="hidden bg-blue-50 rounded-xl mt-3 shadow-lg p-3 transition-all duration-300">
                                                    <% if(userRole==='teacher' ){ %>
                                                        <li><a href="/dashboard/attendance/mark"
                                                                class="block px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">Take
                                                                Attendance</a></li>
                                                        <li><a href="/dashboard/attendance/reports"
                                                                class="block px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">Attendance
                                                                Reports</a></li>
                                                        <%} %>
                                                            <% if(userRole==='student' ){ %>

                                                                <li><a href="/dashboard/attendance/checkattendance"
                                                                        class="block px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">Check
                                                                        Attendance</a></li>
                                                                <%} %>

                                                </ul>
                                            </li>
                                            <%} %>


                                                <!-- Announcements Dropdown -->
                                                <li class="relative">
                                                    <button
                                                        onclick="toggleDropdown('announcementsDropdown', 'announcementsIcon')"
                                                        class="flex items-center justify-between w-full text-blue-700 p-3 rounded-2xl hover:bg-blue-100 transition duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-1">
                                                        <div class="flex items-center">
                                                            <i class="fas fa-bullhorn text-lg hover-scale"></i>
                                                            <span
                                                                class="ml-5 font-semibold text-base">Announcements</span>
                                                        </div>
                                                        <i id="announcementsIcon"
                                                            class='fas fa-chevron-down ml-auto transition-transform'></i>
                                                    </button>

                                                    <ul id="announcementsDropdown"
                                                        class="hidden bg-blue-50 rounded-xl mt-3 shadow-lg p-3 transition-all duration-300">
                                                        <% if(userRole==='admin' ){ %>
                                                            <li><a href="/dashboard/announcement/add"
                                                                    class="block px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">Add
                                                                    Announcement</a></li>
                                                            <li><a href="/dashboard/announcements"
                                                                    class="block px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">All
                                                                    Announcements</a></li>
                                                            <% } %>

                                                                <% if(userRole==='student' ){ %>
                                                                    <li><a href="/dashboard/announcement/class"
                                                                            class="block px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">For
                                                                            Class</a></li>
                                                                    <li><a href="/dashboard/announcement/student"
                                                                            class="block px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">For
                                                                            Students</a></li>
                                                                    <% } %>

                                                                        <% if(userRole==='teacher' ){ %>
                                                                            <li><a href="/dashboard/announcement/teacher"
                                                                                    class="block px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">For
                                                                                    Teacher</a></li>
                                                                            <% } %>




                                                    </ul>
                                                </li>



                                                <% if(userRole==='admin' ){ %>
                                                    <!-- Teachers Dropdown -->
                                                    <li class="relative">
                                                        <button onclick="toggleDropdown('adminDropdown', 'adminsIcon')"
                                                            class="flex items-center justify-between w-full text-blue-700 p-3 rounded-2xl hover:bg-blue-100 transition duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-1">
                                                            <div class="flex items-center">
                                                                <i
                                                                    class="fas fa-chalkboard-teacher text-lg hover-scale"></i>
                                                                <span class="ml-5 font-semibold text-base">Admin</span>
                                                            </div>
                                                            <i id="adminsIcon"
                                                                class='fas fa-chevron-down ml-auto transition-transform'></i>
                                                        </button>

                                                        <ul id="adminDropdown"
                                                            class="hidden bg-blue-50 rounded-xl mt-3 shadow-lg p-3 transition-all duration-300">
                                                            <li><a href="/dashboard/admin/add"
                                                                    class="block px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">Add
                                                                    Admin</a></li>
                                                            <li><a href="/dashboard/admin/reports"
                                                                    class="block px-6 py-3 text-blue-700 hover:bg-blue-200 rounded-lg transition-all duration-300">Admin
                                                                    Reports</a></li>
                                                        </ul>
                                                    </li>
                                                    <%} %>

                                                        <!-- Logout -->
                                                        <li>
                                                            <a href="/dashboard/logout"
                                                                class="flex items-center text-red-600 p-3 rounded-2xl hover:bg-red-100 transition duration-300 shadow-md hover:shadow-lg transform hover:-translate-y-1">
                                                                <i class='fas fa-sign-out-alt text-3xl hover-scale'></i>
                                                                <span class="ml-5 font-semibold text-base">Logout</span>
                                                            </a>
                                                        </li>
    </ul>
</div>

<script>
    function toggleDropdown(dropdownId, iconId) {
        const dropdown = document.getElementById(dropdownId);
        const icon = document.getElementById(iconId);

        dropdown.classList.toggle('hidden');
        icon.classList.toggle('rotate-180');
    }

    document.getElementById('sidebarClose').addEventListener('click', () => {
        document.getElementById('sidebar').classList.toggle('-translate-x-full');
    });
</script>


<style>
    .sidebar {
        transition: transform 0.3s ease-in-out;
    }

    .rotate-180 {
        transform: rotate(180deg);
    }

    .hover-scale {
        transition: transform 0.2s ease-in-out;
    }

    .hover-scale:hover {
        transform: scale(1.1);
    }
</style>