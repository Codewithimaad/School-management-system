                                            <ul class="sub-menu">
                                                <li><a href="/dashboard/class/add">Add Class</a></li>
                                                <li><a href="/dashboard/class/reports">Classes Reports</a></li>
                                            </ul>
                                        </li>
                                        <% } %>


