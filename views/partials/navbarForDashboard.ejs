<nav
    class="bg-white/90 dark:bg-gray-800/90 mb-10 md:mb-0 sticky top-0 w-full z-40 backdrop-blur-lg shadow-md p-2 py-4 md:p-6 flex items-center justify-between rounded-xl">
    <!-- Sidebar Toggle Button (Visible on small screens) -->
    <button id="sidebarToggle" class="lg:hidden text-blue-700 dark:text-blue-400 ml-2 sm:ml-4">
        <svg class="w-7 sm:w-8 h-7 sm:h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
    </button>

    <!-- Brand Name (Centered on sm screens) -->
    <span
        class="text-blue-700 dark:text-blue-400 hidden md:block text-lg sm:text-xl md:text-2xl font-extrabold tracking-wide flex-1 text-center sm:text-left">
        Luminous
    </span>

    <!-- Dark Mode Toggle Button -->
    <button id="darkModeToggle" class="text-gray-700 dark:text-gray-300 mr-4 sm:mr-6 focus:outline-none">
        <i id="darkModeIcon" class="fas fa-moon text-xl"></i> <!-- Default to moon icon (dark mode off) -->
    </button>

    <!-- User Profile with Dropdown -->
    <div class="relative">
        <button id="userDropdownBtn"
            class="flex items-center space-x-2 sm:space-x-3 mr-4 sm:mr-10 lg:mr-6 focus:outline-none">
            <% if (user) { %>
                <img src="<%= user.imageUrl || '/images/Male logo.png' %>" alt="User"
                    class="w-9 sm:w-10 h-9 sm:h-10 rounded-full border border-blue-200 dark:border-blue-600 shadow-sm">
                <span class="text-gray-700 dark:text-gray-300 text-sm sm:text-base font-semibold">
                    <%= user.name %>
                </span>
                <% } %>
        </button>

        <!-- Dropdown Menu -->
        <div id="userDropdown"
            class="absolute right-0 mt-2 w-56 bg-white dark:bg-gray-800 rounded-lg shadow-xl border border-gray-200 dark:border-gray-700 hidden">
            <ul class="py-2">
                <!-- Profile Link -->
                <li>
                    <a href="/dashboard/profile"
                        class="flex items-center px-4 py-3 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-200 ease-in-out">
                        <i class="fa-solid fa-user text-lg text-gray-500 dark:text-gray-400 mr-3"></i>
                        <span>View Profile</span>
                    </a>
                </li>

                <!-- Divider -->
                <li class="border-t border-gray-200 dark:border-gray-700 my-2"></li>

                <!-- Account Link -->
                <li>
                    <a href="/dashboard/user/change-password"
                        class="flex items-center px-4 py-3 text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors duration-200 ease-in-out">
                        <i class="fa-solid fa-gear text-lg text-gray-500 dark:text-gray-400 mr-3"></i>
                        <span>Account Setting</span>

                    </a>
                </li>

                <!-- Divider -->
                <li class="border-t border-gray-200 dark:border-gray-700 my-2"></li>

                <!-- Logout Link -->
                <li>
                    <a href="/dashboard/logout"
                        class="flex items-center px-4 py-3 text-red-600 dark:text-red-400 hover:bg-red-50 dark:hover:bg-red-900/20 transition-colors duration-200 ease-in-out">
                        <i class="fas fa-sign-out-alt text-lg text-red-600 dark:text-red-400 mr-3"></i>
                        <span>Logout</span>
                    </a>
                </li>
            </ul>
        </div>
    </div>
</nav>