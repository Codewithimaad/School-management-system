<nav
    class="bg-white/90 sticky top-0 w-full z-40 backdrop-blur-lg shadow-md p-2 py-4 md:p-6 flex items-center justify-between rounded-xl">
    <!-- Sidebar Toggle Button (Visible on small screens) -->
    <button id="sidebarToggle" class="lg:hidden text-blue-700 ml-2 sm:ml-4">
        <svg class="w-7 sm:w-8 h-7 sm:h-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16m-7 6h7"></path>
        </svg>
    </button>





    <!-- Brand Name (Centered on sm screens) -->
    <span
        class="text-blue-700 hidden md:block text-lg sm:text-xl md:text-2xl font-extrabold tracking-wide flex-1 text-center sm:text-left">
        Luminous
    </span>

    <!-- User Profile with Dropdown -->
    <div class="relative">
        <button id="userDropdownBtn"
            class="flex items-center space-x-2 sm:space-x-3 mr-4 sm:mr-10 lg:mr-6 focus:outline-none">
            <% if (user) { %>
                <img src="<%= user.imageUrl || '/images/Male logo.png' %>" alt="User"
                    class="w-9 sm:w-10 h-9 sm:h-10 rounded-full border border-blue-200 shadow-sm">
                <span class="text-gray-700 text-sm sm:text-base font-semibold">
                    <%= user.name %>
                </span>
                <% } %>

        </button>

        <!-- Dropdown Menu -->
        <div id="userDropdown"
            class="absolute right-0 mt-2 w-48 bg-white rounded-lg shadow-lg border border-gray-200 hidden">
            <ul class="py-2">
                <li><a href="/dashboard/profile" class="block px-4 py-2 text-gray-700 hover:bg-gray-100">👤 View
                        Profile</a></li>

            </ul>
        </div>
    </div>
</nav>

<!-- JavaScript for Dropdown -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const dropdownBtn = document.getElementById("userDropdownBtn");
        const dropdownMenu = document.getElementById("userDropdown");

        dropdownBtn.addEventListener("click", function (event) {
            dropdownMenu.classList.toggle("hidden");
        });

        // Close dropdown if clicked outside
        document.addEventListener("click", function (event) {
            if (!dropdownBtn.contains(event.target) && !dropdownMenu.contains(event.target)) {
                dropdownMenu.classList.add("hidden");
            }
        });
    });
</script>