<%- include('../../partials/dashboard') %>

    <main class="flex-grow p-6 md:p-10 lg:p-12">
        <!-- Flash Messages -->
        <%- include('../../partials/flashMessage') %>

            <!-- Header Section -->
            <header
                class="flex flex-wrap gap-5 items-center justify-between bg-white text-gray-800 rounded-lg shadow-lg px-8 py-6 mb-8">
                <div>
                    <h2 class="text-3xl font-semibold tracking-wide">All Announcements</h2>
                    <p class="text-sm">List of all announcements</p>
                </div>
                <a href="/dashboard/announcement/add"
                    class="bg-white text-gray-800 hover:bg-gray-200 font-semibold px-6 py-3 rounded-lg shadow-md transition duration-300">
                    Add Announcement
                </a>
            </header>

            <!-- Announcements Section -->
            <div class="space-y-6">
                <% announcements.forEach(announcement=> { %>
                    <div class="bg-white p-6 rounded-lg shadow-lg">
                        <h3 class="text-xl font-semibold text-gray-800">
                            <%= announcement.title %>
                        </h3>
                        <p class="text-sm text-gray-500 mt-2">
                            Audience:
                            <% if (announcement.audience==='class' && announcement.classId) { %>
                                <%= announcement.classId.name %>
                                    <% } else { %>
                                        <%= announcement.audience %>
                                            <% } %>
                        </p>
                        <p class="mt-2 text-gray-700">
                            <%= announcement.content %>
                        </p>

                        <div class="mt-4 flex justify-between items-center">
                            <a href="/dashboard/announcement/edit/<%= announcement._id %>"
                                class="text-blue-600 hover:text-blue-800 font-semibold">Edit</a>
                            <!-- Delete Button with SweetAlert confirmation -->
                            <button class="text-red-500 hover:text-red-700 font-semibold delete-btn"
                                data-id="<%= announcement._id %>">Delete</button>
                        </div>
                    </div>
                    <% }); %>
            </div>
    </main>

    <!-- SweetAlert2 Script for Delete Confirmation -->
    <script>
        document.querySelectorAll('.delete-btn').forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                const deleteID = this.getAttribute('data-id');

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, delete it!',
                    cancelButtonText: 'No, keep it',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                            title: "Deleted!",
                            text: "The announcement has been deleted.",
                            icon: "success"
                        });
                        // Redirect to delete route if confirmed
                        window.location.href = `/dashboard/announcement/delete/${deleteID}`;
                    }
                });
            });
        });
    </script>

    <%- include('../../partials/dashboardfooter') %>