<!-- views/dashboard/announcementPages/teacherAnnouncements.ejs -->

<%- include('../../partials/dashboard') %>

    <main class="flex-grow p-6 md:p-10 lg:p-12">
        <!-- Flash Messages -->
        <%- include('../../partials/flashMessage') %>

            <!-- Header Section -->
            <header
                class="flex items-center justify-between bg-white shadow-lg rounded-xl p-6 mb-8 border border-gray-200">
                <div>
                    <h2 class="text-3xl font-bold text-gray-800">📢 Teacher Announcements</h2>
                    <p class="text-sm text-gray-500">Stay updated with the latest announcements.</p>
                </div>
            </header>

            <!-- Announcements Section -->
            <section class="space-y-6">
                <% if (announcements.length> 0) { %>
                    <% announcements.forEach(announcement=> { %>
                        <div
                            class="bg-white shadow-md rounded-xl p-6 border border-gray-200 hover:shadow-lg transition duration-300">
                            <h3 class="text-xl font-semibold text-gray-900">
                                <%= announcement.title %>
                            </h3>
                            <p class="text-gray-700 mt-2 leading-relaxed">
                                <%= announcement.content %>
                            </p>
                            <p class="text-gray-500 text-sm mt-4">📅 Posted on: <%=
                                    announcement.createdAt.toLocaleDateString() %>
                            </p>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <div class="bg-white p-6 rounded-xl shadow-md text-center border border-gray-200">
                                    <p class="text-gray-600">🚫 No announcements available at the moment.</p>
                                </div>
                                <% } %>
            </section>
    </main>

    <%- include('../../partials/dashboardfooter') %>