<!-- views/dashboard/announcementPages/teacherAnnouncements.ejs -->

<%- include('../../partials/dashboard') %>

    <main class="flex-grow p-6 md:p-10 lg:p-12">
        <!-- Flash Messages -->
        <%- include('../../partials/flashMessage') %>

            <!-- Header Section -->
            <header
                class="flex items-center justify-between bg-white dark:bg-gray-800 shadow-lg rounded-xl p-6 mb-8 text-gray-700 dark:text-white">
                <div>
                    <h2 class="text-3xl font-bold">📢 Teacher Announcements</h2>
                    <p class="text-sm">Stay updated with the latest announcements.</p>
                </div>
            </header>

            <!-- Announcements Section -->
            <section class="space-y-6">
                <% if (announcements.length> 0) { %>
                    <% announcements.forEach(announcement=> { %>
                        <div
                            class="bg-white dark:bg-gray-800 shadow-md rounded-xl p-6 hover:shadow-lg transition duration-300 text-gray-700 dark:text-white">
                            <h3 class="text-xl font-semibold ">
                                <%= announcement.title %>
                            </h3>
                            <p class=" mt-2 leading-relaxed">
                                <%= announcement.content %>
                            </p>
                            <p class=" text-sm mt-4">📅 Posted on: <%= announcement.createdAt.toLocaleDateString() %>
                            </p>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <div class="bg-white p-6 rounded-xl shadow-md text-center border border-gray-200">
                                    <p class="">🚫 No announcements available at the moment.</p>
                                </div>
                                <% } %>
            </section>
    </main>

    <%- include('../../partials/dashboardfooter') %>