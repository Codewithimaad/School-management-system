<!-- views/dashboard/announcementPages/teacherAnnouncements.ejs -->

<%- include('../../partials/dashboard') %>

    <main class="flex-grow p-6 md:p-10 lg:p-12 bg-gray-100">
        <!-- Flash Messages -->
        <%- include('../../partials/flashMessage') %>

            <!-- Header Section -->
            <header
                class="flex items-center justify-between bg-gradient-to-r from-blue-500 to-blue-700 text-white rounded-lg shadow-lg px-8 py-6 mb-8">
                <div>
                    <h2 class="text-3xl font-bold tracking-wide">All Announcements</h2>
                    <p class="text-sm">View the latest announcements for all audiences</p>
                </div>
            </header>

            <!-- Announcements Section -->
            <section class="space-y-6">
                <% if (announcements.length> 0) { %>
                    <% announcements.forEach(announcement=> { %>
                        <div class="bg-white shadow-lg rounded-lg p-6">
                            <h3 class="text-xl font-semibold text-gray-800">
                                <%= announcement.title %>
                            </h3>
                            <p class="text-gray-600 mt-2">
                                <%= announcement.content %>
                            </p>
                            <p class="text-gray-400 text-sm mt-2">
                                Posted on: <%= announcement.createdAt.toLocaleDateString() %>
                            </p>
                        </div>
                        <% }); %>
                            <% } else { %>
                                <div class="bg-white p-6 rounded-lg shadow-lg">
                                    <p class="text-gray-600">No announcements available for all audiences at the moment.
                                    </p>
                                </div>
                                <% } %>
            </section>
    </main>

    <%- include('../../partials/dashboardfooter') %>