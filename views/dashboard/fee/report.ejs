<%- include('../../partials/dashboard') %>

    <main class="flex-grow p-4 md:p-8 lg:p-12">
        <!-- Flash Messages -->
        <%- include('../../partials/flashMessage') %>

            <!-- Header Section -->
            <header
                class="flex flex-wrap gap-5 items-center justify-between bg-white rounded-xl shadow-2xl px-8 py-6 mb-8">
                <div>
                    <h2
                        class="text-2xl md:text-3xl font-bold text-gray-900 bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
                        Fee Reports
                    </h2>
                    <p class="text-sm text-gray-600">An overview of all student fee reports.</p>
                </div>
                <a href="/dashboard/fee/add"
                    class="bg-gradient-to-r from-blue-600 to-purple-600 text-white text-sm md:text-lg font-semibold px-6 py-2.5 rounded-lg shadow-md hover:shadow-lg transition-all transform hover:scale-105">
                    Add New Fee
                </a>
            </header>

            <!-- Filter Form -->
            <form action="/dashboard/fee/reports" method="GET" class="mb-8 bg-white p-6 rounded-xl shadow-xl">
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                    <!-- Class Dropdown -->
                    <div>
                        <label for="classDropdown" class="block text-sm font-medium text-gray-700 mb-2">Class</label>
                        <select name="classId" id="classDropdown"
                            class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all">
                            <option value="">All Classes</option>
                            <% classes.forEach(cls=> { %>
                                <option value="<%= cls._id %>" <%=filters.classId===cls._id.toString() ? 'selected' : ''
                                    %>>
                                    <%= cls.name %>
                                </option>
                                <% }); %>
                        </select>
                    </div>

                    <!-- Student Dropdown -->
                    <div>
                        <label for="studentDropdown"
                            class="block text-sm font-medium text-gray-700 mb-2">Student</label>
                        <select name="studentId" id="studentDropdown"
                            class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all">
                            <option value="">All Students</option>
                            <% students.forEach(student=> { %>
                                <option value="<%= student._id %>" <%=filters.studentId===student._id.toString()
                                    ? 'selected' : '' %>>
                                    <%= student.name %>
                                </option>
                                <% }); %>
                        </select>
                    </div>

                    <!-- Payment Status Dropdown -->
                    <div>
                        <label for="paymentStatus" class="block text-sm font-medium text-gray-700 mb-2">Payment
                            Status</label>
                        <select name="paymentStatus" id="paymentStatus"
                            class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all">
                            <option value="">All</option>
                            <option value="Paid" <%=filters.paymentStatus==='Paid' ? 'selected' : '' %>>Paid</option>
                            <option value="Unpaid" <%=filters.paymentStatus==='Unpaid' ? 'selected' : '' %>>Unpaid
                            </option>
                        </select>
                    </div>

                    <!-- Date Range Inputs -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <label for="startDate" class="block text-sm font-medium text-gray-700 mb-2">Start
                                Date</label>
                            <input type="date" name="startDate" value="<%= filters.startDate || '' %>" id="startDate"
                                class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all">
                        </div>
                        <div>
                            <label for="endDate" class="block text-sm font-medium text-gray-700 mb-2">End Date</label>
                            <input type="date" name="endDate" value="<%= filters.endDate || '' %>" id="endDate"
                                class="w-full px-4 py-2.5 bg-gray-50 border border-gray-300 rounded-lg shadow-sm focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all">
                        </div>
                    </div>
                </div>

                <!-- Filter Button -->
                <div class="mt-6 flex justify-end">
                    <button type="submit"
                        class="px-6 py-2.5 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-lg shadow-md hover:shadow-lg transition-all transform hover:scale-105">
                        Filter
                    </button>
                </div>
            </form>

            <!-- Fee Report Table -->
            <div class="overflow-x-auto bg-white rounded-xl shadow-2xl">
                <table class="min-w-full">
                    <thead class="bg-gray-100">
                        <tr class="border-b">
                            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Class</th>
                            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Student</th>
                            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Category</th>
                            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Amount</th>
                            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Month</th>
                            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Due Date</th>
                            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Payment Status</th>
                            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Payment Date</th>
                            <th class="px-6 py-3 text-left text-sm font-semibold text-gray-700">Actions</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-600">
                        <% if (fees.length> 0) { %>
                            <% fees.forEach(fee=> { %>
                                <tr class="border-b hover:bg-gray-50 transition duration-300">
                                    <td class="px-6 py-4 text-sm">
                                        <%= fee.classId.name %>
                                    </td>
                                    <td class="px-6 py-4 text-sm">
                                        <%= fee.studentId ? fee.studentId.name : 'N/A' %>
                                    </td>
                                    <td class="px-6 py-4 text-sm">
                                        <%= fee.category %>
                                    </td>
                                    <td class="px-6 py-4 text-sm">
                                        <%= fee.amount %>
                                    </td>
                                    <td class="px-6 py-4 text-sm">
                                        <%= fee.month %>
                                    </td>
                                    <td class="px-6 py-4 text-sm">
                                        <%= new Date(fee.dueDate).toLocaleDateString() %>
                                    </td>
                                    <td class="px-6 py-4 text-sm">
                                        <% if(fee.paymentStatus==='Paid' ){ %>
                                            <span class="text-green-600">Paid</span>
                                            <% } else { %>
                                                <span class="text-red-600">Unpaid</span>
                                                <% } %>
                                    </td>
                                    <td class="px-6 py-4 text-sm">
                                        <%= fee.paymentDate ? new Date(fee.paymentDate).toLocaleDateString() : 'N/A' %>
                                    </td>
                                    <td
                                        class="px-6 py-4 text-sm flex flex-col sm:flex-row sm:items-center sm:justify-start space-y-2 sm:space-y-0 sm:space-x-4">
                                        <!-- View Button -->
                                        <a href="/dashboard/fee/details/<%= fee._id %>"
                                            class="px-4 py-2 bg-blue-500 text-white rounded-lg shadow-md hover:bg-blue-600 transition-all">
                                            View
                                        </a>

                                        <!-- Delete Button -->
                                        <button
                                            class="px-4 py-2 bg-red-500 text-white rounded-lg shadow-md hover:bg-red-600 transition-all delete-btn"
                                            data-id="<%= fee._id %>">
                                            Delete
                                        </button>

                                        <!-- Mark Paid Button -->
                                        <% if (fee.paymentStatus !=='Paid' ) { %>
                                            <button
                                                class="px-4 py-2 text-sm bg-green-600 text-white rounded-lg shadow-md hover:bg-green-700 transition-all paid-btn"
                                                data-id="<%= fee._id %>">
                                                Mark Paid
                                            </button>
                                            <% } else { %>
                                                <span class="text-gray-400">Paid</span>
                                                <% } %>
                                    </td>
                                </tr>
                                <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="9" class="text-center py-4 text-gray-600">No records found</td>
                                        </tr>
                                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Pagination -->
            <div class="mt-6 flex flex-col sm:flex-row items-center justify-between bg-white p-4 rounded-xl shadow-2xl">
                <div class="text-sm text-gray-600 mb-4 sm:mb-0">
                    <% let startIndex=(currentPage - 1) * 15 + 1; %>
                        <% let endIndex=startIndex + fees.length - 1; %>
                            Showing <%= startIndex %> - <%= endIndex %> of <%= totalFees %> fees
                </div>

                <nav class="flex items-center space-x-2">
                    <!-- Previous Button -->
                    <% if (currentPage> 1) { %>
                        <a href="/dashboard/fee/reports?page=<%= currentPage - 1 %>&classId=<%= filters.classId %>&studentId=<%= filters.studentId %>&paymentStatus=<%= filters.paymentStatus %>&startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>"
                            class="px-3 py-1 text-sm font-medium border rounded-lg text-gray-600 hover:bg-gray-100 transition-all">
                            Previous
                        </a>
                        <% } else { %>
                            <span class="px-3 py-1 text-sm font-medium border rounded-lg text-gray-400">
                                Previous
                            </span>
                            <% } %>

                                <!-- Page Numbers -->
                                <% for (let page=1; page <=totalPages; page++) { %>
                                    <a href="/dashboard/fee/reports?page=<%= page %>&classId=<%= filters.classId %>&studentId=<%= filters.studentId %>&paymentStatus=<%= filters.paymentStatus %>&startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>"
                                        class="px-3 py-1 text-sm font-medium border rounded-lg <%= currentPage === page ? 'bg-blue-600 text-white' : 'bg-white text-gray-600 hover:bg-gray-100' %> transition-all">
                                        <%= page %>
                                    </a>
                                    <% } %>

                                        <!-- Next Button -->
                                        <% if (currentPage < totalPages) { %>
                                            <a href="/dashboard/fee/reports?page=<%= currentPage + 1 %>&classId=<%= filters.classId %>&studentId=<%= filters.studentId %>&paymentStatus=<%= filters.paymentStatus %>&startDate=<%= filters.startDate %>&endDate=<%= filters.endDate %>"
                                                class="px-3 py-1 text-sm font-medium border rounded-lg text-gray-600 hover:bg-gray-100 transition-all">
                                                Next
                                            </a>
                                            <% } else { %>
                                                <span
                                                    class="px-3 py-1 text-sm font-medium border rounded-lg text-gray-400">
                                                    Next
                                                </span>
                                                <% } %>
                </nav>
            </div>
    </main>

    <%- include('../../partials/dashboardfooter') %>

        <script>
            const classDropdown = document.getElementById('classDropdown');
            const studentDropdown = document.getElementById('studentDropdown');

            classDropdown.addEventListener('change', async () => {
                const classId = classDropdown.value;
                studentDropdown.innerHTML = '<option value="">All Students</option>';

                if (classId) {
                    try {
                        const response = await fetch(`/dashboard/fee/students/${classId}`);
                        const students = await response.json();

                        students.forEach(student => {
                            const option = document.createElement('option');
                            option.value = student._id;
                            option.textContent = `${student.name} (${student.roll_number})`;
                            studentDropdown.appendChild(option);
                        });
                    } catch (error) {
                        console.error('Error fetching students:', error);
                        studentDropdown.innerHTML = '<option value="">Error fetching students</option>';
                    }
                }
            });
        </script>

        <script>
            // SweetAlert2 script for "Mark Paid" confirmation
            document.querySelectorAll('.paid-btn').forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    const feeID = this.getAttribute('data-id'); // Get Fee ID

                    Swal.fire({
                        title: 'Mark as Paid?',
                        text: "This will update the fee status to Paid.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, mark as Paid!',
                        cancelButtonText: 'No, cancel!',
                        reverseButtons: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Send a POST request to mark the fee as Paid
                            fetch(`/dashboard/fee/mark-paid/${feeID}`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-Requested-With': 'XMLHttpRequest' // To differentiate AJAX requests
                                }
                            })
                                .then(response => {
                                    if (response.ok) {
                                        Swal.fire({
                                            title: "Success!",
                                            text: "Fee has been marked as Paid.",
                                            icon: "success"
                                        }).then(() => {
                                            window.location.reload(); // Reload the page to reflect changes
                                        });
                                    } else {
                                        Swal.fire({
                                            title: "Error",
                                            text: "Could not update the fee status. Please try again.",
                                            icon: "error"
                                        });
                                    }
                                })
                                .catch(err => {
                                    console.error(err);
                                    Swal.fire({
                                        title: "Error",
                                        text: "An unexpected error occurred.",
                                        icon: "error"
                                    });
                                });
                        }
                    });
                });
            });
        </script>

        <script>
            // SweetAlert2 script for "Delete" confirmation
            document.querySelectorAll('.delete-btn').forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    const feeID = this.getAttribute('data-id'); // Get Fee ID

                    Swal.fire({
                        title: 'Are you sure to delete this fee?',
                        text: "This will delete the fee.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, delete it!',
                        cancelButtonText: 'No, cancel!',
                        reverseButtons: true
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Send a GET request to delete the fee
                            fetch(`/dashboard/fee/delete/${feeID}`, {
                                method: 'GET',
                                headers: {
                                    'Content-Type': 'application/json',
                                    'X-Requested-With': 'XMLHttpRequest' // To differentiate AJAX requests
                                }
                            })
                                .then(response => {
                                    if (response.ok) {
                                        Swal.fire({
                                            title: "Success!",
                                            text: "Fee has been deleted.",
                                            icon: "success"
                                        }).then(() => {
                                            window.location.reload(); // Reload the page to reflect changes
                                        });
                                    } else {
                                        Swal.fire({
                                            title: "Error",
                                            text: "Could not delete the fee. Please try again.",
                                            icon: "error"
                                        });
                                    }
                                })
                                .catch(err => {
                                    console.error(err);
                                    Swal.fire({
                                        title: "Error",
                                        text: "An unexpected error occurred.",
                                        icon: "error"
                                    });
                                });
                        }
                    });
                });
            });
        </script>