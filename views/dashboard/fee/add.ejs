<%- include('../../partials/dashboard') %>

    <main class="flex-grow p-4 md:p-8 lg:p-12">
        <!-- Flash Messages -->
        <%- include('../../partials/flashMessage') %>

            <!-- Header Section -->
            <header
                class="flex flex-wrap gap-5 items-center justify-between bg-white rounded-xl shadow-2xl px-8 py-6 mb-8">
                <div>
                    <h2
                        class="text-2xl md:text-3xl font-bold text-gray-900 bg-gradient-to-r from-blue-600 to-purple-600 bg-clip-text text-transparent">
                        Add Fee
                    </h2>
                    <p class="text-sm text-gray-600">Fill in the details to add a new fee.</p>
                </div>
                <a href="/dashboard/fee/reports"
                    class="bg-gradient-to-r from-blue-600 to-purple-600 text-white text-sm md:text-lg font-semibold px-6 py-2.5 rounded-lg shadow-md hover:shadow-lg transition-all transform hover:scale-105">
                    All Fee Reports
                </a>
            </header>

            <!-- Add Fee Form -->
            <form action="/dashboard/fee/add" method="POST"
                class="space-y-6 bg-white p-6 md:p-12 rounded-2xl shadow-2xl">
                <!-- Class and Student Dropdowns -->
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Class Dropdown -->
                    <div>
                        <label for="classDropdown" class="block text-sm font-medium text-gray-700 mb-2">Class</label>
                        <select name="classId" id="classDropdown"
                            class="w-full px-4 py-2.5 bg-gray-100 rounded-lg shadow-sm focus:ring-1 focus:ring-blue-300 focus:outline-none transition-all">
                            <option value="">Select Class</option>
                            <% classes.forEach(cls=> { %>
                                <option value="<%= cls._id %>">
                                    <%= cls.name %>
                                </option>
                                <% }); %>
                        </select>
                    </div>

                    <!-- Student Dropdown -->
                    <div>
                        <label for="studentDropdown"
                            class="block text-sm font-medium text-gray-700 mb-2">Student</label>
                        <select name="studentId" id="studentDropdown"
                            class="w-full px-4 py-2.5 bg-gray-100 rounded-lg shadow-sm focus:ring-1 focus:ring-blue-300 focus:outline-none transition-all">
                            <option value="">Select Student</option>
                        </select>
                    </div>
                </div>

                <!-- Category, Month, and Amount Inputs -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Category Dropdown -->
                    <div>
                        <label for="category" class="block text-sm font-medium text-gray-700 mb-2">Category</label>
                        <select name="category"
                            class="w-full px-4 py-2.5 bg-gray-100 rounded-lg shadow-sm focus:ring-1 focus:ring-blue-300 focus:outline-none transition-all">
                            <option value="Fee Category" disabled selected>Fee Category</option>
                            <option value="Tuition">Tuition</option>
                            <option value="Stationary">Stationary</option>
                            <option value="Exam Fee">Exam Fee</option>
                            <option value="Transport">Transport</option>
                            <option value="Admission">Admission</option>
                            <option value="Library">Library</option>
                            <option value="Others">Others</option>
                        </select>
                    </div>

                    <!-- Month Input -->
                    <div>
                        <label for="month" class="block text-sm font-medium text-gray-700 mb-2">Fee Month</label>
                        <select name="month"
                            class="w-full px-4 py-2.5 bg-gray-100 focus:outline-none rounded-lg shadow-sm focus:ring-1 focus:ring-blue-300 transition-all">
                            <option value="Select Month" disabled selected>Select Month</option>
                            <option value="January">January</option>
                            <option value="February">February</option>
                            <option value="March">March</option>
                            <option value="April">April</option>
                            <option value="May">May</option>
                            <option value="June">June</option>
                            <option value="July">July</option>
                            <option value="August">August</option>
                            <option value="September">September</option>
                            <option value="October">October</option>
                            <option value="November">November</option>
                            <option value="December">December</option>
                        </select>
                    </div>

                    <!-- Amount Input -->
                    <div>
                        <label for="amount" class="block text-sm font-medium text-gray-700 mb-2">Amount</label>
                        <input type="number" name="amount" id="amount"
                            class="w-full px-4 py-2.5 bg-gray-100 rounded-lg shadow-sm focus:ring-1 focus:ring-blue-300 focus:outline-none transition-all"
                            placeholder="Enter Amount" required>
                    </div>
                </div>

                <!-- Due Date Input -->
                <div>
                    <label for="dueDate" class="block text-sm font-medium text-gray-700 mb-2">Due Date</label>
                    <input type="date" name="dueDate" id="dueDate"
                        class="w-full px-4 py-2.5 bg-gray-100 rounded-lg shadow-sm focus:ring-1 focus:outline-none  focus:ring-blue-300 transition-all"
                        required>
                </div>

                <!-- Submit Button -->
                <div class="flex justify-end">
                    <button type="submit"
                        class="px-8 py-3 bg-gradient-to-r from-blue-600 to-purple-600 text-white rounded-lg shadow-md hover:shadow-lg transition-all transform hover:scale-105">
                        Add Fee
                    </button>
                </div>
            </form>
    </main>

    <%- include('../../partials/dashboardfooter') %>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const classDropdown = document.getElementById('classDropdown');
                const studentDropdown = document.getElementById('studentDropdown');

                classDropdown.addEventListener('change', async () => {
                    const classId = classDropdown.value;
                    studentDropdown.innerHTML = '<option value="">Select Student</option>';

                    if (classId) {
                        try {
                            const response = await fetch(`/dashboard/fee/students/${classId}`);
                            if (!response.ok) throw new Error("Failed to fetch students");

                            const students = await response.json();
                            students.forEach(student => {
                                const option = document.createElement('option');
                                option.value = student._id;
                                option.textContent = student.name;
                                studentDropdown.appendChild(option);
                            });
                        } catch (error) {
                            console.error('Error fetching students:', error);
                            studentDropdown.innerHTML = '<option value="">Error fetching students</option>';
                        }
                    }
                });
            });
        </script>