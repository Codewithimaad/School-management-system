<%- include('../../partials/dashboard') %>

    <main class="flex-grow p-4 md:p-8 lg:p-12">
        <!-- Flash Messages -->
        <%- include('../../partials/flashMessage') %>

            <!-- Header Section -->
            <header
                class="flex flex-wrap gap-5 items-center justify-between bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 mb-8 border border-gray-100 dark:border-gray-700">
                <div>
                    <h2 class="text-3xl font-semibold tracking-wide text-gray-800 dark:text-white">Attendance Report
                    </h2>
                    <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">List of all attendance reports of students.
                    </p>
                </div>
                <% if(userRole==='teacher' ){ %>
                    <a href="/dashboard/attendance/mark"
                        class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-md shadow-md transition duration-300">
                        Take Attendance
                    </a>
                    <% } %>

            </header>

            <!-- Search Form -->
            <div
                class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 mb-8 border border-gray-100 dark:border-gray-700">
                <form action="/dashboard/attendance/reports" method="GET"
                    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4">
                    <!-- Search by Name -->
                    <input type="text" name="name" value="<%= searchQuery.name %>" placeholder="Search by student name"
                        class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white sm:col-span-2">

                    <!-- Search by Class -->
                    <select name="stdClass"
                        class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                        <option value="">Select Class</option>
                        <% classes.forEach(classItem=> { %>
                            <option value="<%= classItem._id %>" <%=searchQuery.stdClass &&
                                searchQuery.stdClass.toString()===classItem._id.toString() ? 'selected' : '' %>>
                                <%= classItem.name %>
                            </option>
                            <% }) %>
                    </select>

                    <!-- Search by Roll Number -->
                    <input type="text" name="roll_number" value="<%= searchQuery.roll_number %>"
                        placeholder="Roll number"
                        class="w-full px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white">

                    <!-- Date Range -->
                    <div class="flex flex-wrap gap-4 sm:col-span-2">
                        <input type="date" name="startDate" value="<%= searchQuery.startDate %>"
                            class="w-full sm:w-auto flex-1 px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                        <input type="date" name="endDate" value="<%= searchQuery.endDate %>"
                            class="w-full sm:w-auto flex-1 px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 dark:bg-gray-700 dark:border-gray-600 dark:text-white">
                    </div>

                    <!-- Submit Button -->
                    <button type="submit"
                        class="w-full sm:w-auto px-6 py-2 bg-blue-600 text-white rounded-lg shadow-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 sm:col-span-2 lg:col-span-1">
                        Search
                    </button>
                </form>
            </div>

            <!-- Attendance Report Table (Hidden initially until search) -->
            <% if (searchQuery && (searchQuery.stdClass || searchQuery.name || searchQuery.roll_number ||
                searchQuery.startDate || searchQuery.endDate)) { %>
                <% if (attendanceData && attendanceData.length> 0) { %>
                    <div
                        class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 border border-gray-100 dark:border-gray-700">
                        <h3 class="text-2xl font-semibold text-gray-800 dark:text-white mb-6">Student Attendance Report
                        </h3>
                        <div class="overflow-x-auto">
                            <table class="min-w-full table-auto border-collapse">
                                <thead class="bg-gray-50 dark:bg-gray-700">
                                    <tr>
                                        <th
                                            class="py-3 px-4 text-left text-sm font-medium text-gray-600 dark:text-gray-300">
                                            Student Name</th>
                                        <th
                                            class="py-3 px-4 text-left text-sm font-medium text-gray-600 dark:text-gray-300">
                                            Roll No</th>
                                        <th
                                            class="py-3 px-4 text-left text-sm font-medium text-gray-600 dark:text-gray-300">
                                            Year</th>
                                        <th
                                            class="py-3 px-4 text-left text-sm font-medium text-gray-600 dark:text-gray-300">
                                            Action</th>
                                    </tr>
                                </thead>
                                <tbody class="text-gray-700 dark:text-gray-300">
                                    <% attendanceData.forEach(({ student, yearlyAttendance })=> { %>
                                        <% for (const [year, attendance] of Object.entries(yearlyAttendance)) { %>
                                            <tr class="border-b  transition duration-300">
                                                <td class="py-4 px-4">
                                                    <%= student.name %>
                                                </td>
                                                <td class="py-4 px-4">
                                                    <%= student.roll_number %>
                                                </td>
                                                <td class="py-4 px-4">
                                                    <%= year %>
                                                </td>
                                                <td class="py-4 px-4">
                                                    <a href="/dashboard/attendance/view/<%= student._id %>"
                                                        class="text-blue-600 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-600 font-medium">View
                                                        All Attendance</a>
                                                </td>
                                            </tr>
                                            <% } %>
                                                <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <% } else { %>
                        <div
                            class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 border border-gray-100 dark:border-gray-700">
                            <p class="text-center text-gray-600 dark:text-gray-400">No attendance records found for the
                                given criteria.</p>
                        </div>
                        <% } %>
                            <% } else { %>
                                <div
                                    class="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 border border-gray-100 dark:border-gray-700">
                                    <p class="text-center text-gray-600 dark:text-gray-400">Search for students'
                                        attendance reports.</p>
                                </div>
                                <% } %>
    </main>

    <%- include('../../partials/dashboardfooter') %>