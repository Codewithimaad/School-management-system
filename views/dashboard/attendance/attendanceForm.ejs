<%- include('../../partials/dashboard') %>

    <main class="flex-grow p-4 md:p-8 lg:p-12">
        <!-- Flash Messages -->
        <%- include('../../partials/flashMessage') %>

            <!-- Header Section -->
            <header
                class="flex items-center justify-between bg-white dark:bg-gray-800 dark:text-white rounded-xl shadow-lg p-6 mb-8 border border-gray-100 dark:border-gray-700">
                <div>
                    <h2 class="text-3xl font-semibold tracking-wide text-gray-800 dark:text-white">Mark Attendance</h2>
                    <p class="text-sm text-gray-500 dark:text-gray-300 mt-1">Select a date to mark attendance for
                        students.</p>
                </div>
                <a href="/dashboard/attendance/reports"
                    class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-2 rounded-md shadow-md transition duration-300">
                    Attendance Reports
                </a>
            </header>

            <!-- Search Section -->
            <div
                class="bg-white dark:bg-gray-800 dark:text-white rounded-xl shadow-lg p-6 mb-8 border border-gray-100 dark:border-gray-700">
                <form action="/dashboard/attendance/mark" method="GET"
                    class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
                    <!-- Select Date -->
                    <input type="date" name="date" id="date" value="<%= searchQuery.date %>"
                        class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring focus:ring-blue-500 text-sm bg-white dark:bg-gray-700 dark:text-white">

                    <!-- Select Class -->
                    <select name="stdClass" id="stdClass"
                        class="px-4 py-2 border border-gray-300 dark:border-gray-600 rounded-md shadow-sm focus:outline-none focus:ring focus:ring-blue-500 text-sm bg-white dark:bg-gray-700 dark:text-white">
                        <option value="">Select Class</option>
                        <% classes.forEach(classItem=> { %>
                            <option value="<%= classItem._id %>" <%=searchQuery.stdClass &&
                                searchQuery.stdClass.toString()===classItem._id.toString() ? 'selected' : '' %>>
                                <%= classItem.name %>
                            </option>
                            <% }) %>
                    </select>

                    <!-- Search Button -->
                    <button type="submit"
                        class="col-span-1 sm:col-span-2 md:col-span-1 py-2 px-4 bg-blue-600 text-white rounded-md shadow-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-300 transition duration-200 ease-in-out">
                        <i class="fas fa-search mr-2"></i>Search
                    </button>
                </form>
            </div>

            <!-- Attendance Form -->
            <% if (students.length> 0) { %>
                <form method="POST" action="/dashboard/attendance/save" class="space-y-4">
                    <input type="hidden" name="classId" value="<%= searchQuery.stdClass %>">
                    <input type="hidden" name="date" value="<%= searchQuery.date %>">
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
                        <% students.forEach(student=> { %>
                            <div
                                class="bg-white dark:bg-gray-800 dark:text-white p-4 rounded-xl shadow-md border border-gray-100 dark:border-gray-700">
                                <label class="block font-semibold text-gray-700 dark:text-white">
                                    <%= student.name %> (Roll No: <%= student.roll_number %>)
                                </label>
                                <div class="mt-2 flex flex-wrap gap-2">
                                    <label class="flex items-center gap-2">
                                        <input type="radio" name="attendance[<%= student._id %>][status]"
                                            value="Present" required class="form-radio h-4 w-4 text-blue-600">
                                        <span class="text-sm">Present</span>
                                    </label>
                                    <label class="flex items-center gap-2">
                                        <input type="radio" name="attendance[<%= student._id %>][status]" value="Absent"
                                            class="form-radio h-4 w-4 text-blue-600">
                                        <span class="text-sm">Absent</span>
                                    </label>
                                    <label class="flex items-center gap-2">
                                        <input type="radio" name="attendance[<%= student._id %>][status]" value="Late"
                                            class="form-radio h-4 w-4 text-blue-600">
                                        <span class="text-sm">Late</span>
                                    </label>
                                    <label class="flex items-center gap-2">
                                        <input type="radio" name="attendance[<%= student._id %>][status]" value="Leave"
                                            class="form-radio h-4 w-4 text-blue-600">
                                        <span class="text-sm">Leave</span>
                                    </label>
                                </div>
                                <textarea name="attendance[<%= student._id %>][remarks]"
                                    placeholder="Remarks (optional)"
                                    class="w-full mt-2 p-2 border border-gray-300 dark:border-gray-600 rounded-md text-sm focus:outline-none focus:ring focus:ring-blue-500 bg-white dark:bg-gray-700 dark:text-white"></textarea>
                            </div>
                            <% }); %>
                    </div>
                    <button type="submit"
                        class="w-full py-2 px-4 bg-blue-600 text-white rounded-md shadow-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-300 transition duration-200 ease-in-out">
                        Save Attendance
                    </button>
                </form>
                <% } else { %>
                    <div
                        class="bg-white dark:bg-gray-800 dark:text-white rounded-xl shadow-lg p-6 border border-gray-100 dark:border-gray-700">
                        <p class="text-gray-500 dark:text-gray-300 text-center">No students found for the selected date
                            and class.</p>
                    </div>
                    <% } %>
    </main>

    <%- include('../../partials/dashboardfooter') %>