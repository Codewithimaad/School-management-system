<%- include('../../partials/dashboard') %>

    <main class="flex-grow p-4 md:p-8 lg:p-12">
        <!-- Flash Messages -->
        <%- include('../../partials/flashMessage') %>

            <!-- Header Section -->
            <header
                class="flex flex-col sm:flex-row sm:items-center sm:justify-between bg-white rounded-xl shadow-lg p-6 mb-8 border border-gray-100">
                <h2 class="text-2xl sm:text-3xl font-semibold tracking-wide text-gray-800 text-center sm:text-left">
                    Attendance Details for <%= student.name %>
                </h2>
            </header>

            <!-- Attendance Summary -->
            <div class="bg-white rounded-xl shadow-lg p-6 mb-8 border border-gray-100">
                <h3 class="text-xl font-semibold text-gray-800 mb-4">Attendance Summary</h3>
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
                    <div class="bg-gray-50 p-4 rounded-lg shadow-sm">
                        <p class="text-sm text-gray-500">Class</p>
                        <p class="text-lg font-medium text-gray-800">
                            <%= student.stdClass.name %>
                        </p>
                    </div>
                    <div class="bg-gray-50 p-4 rounded-lg shadow-sm">
                        <p class="text-sm text-gray-500">Total Days</p>
                        <p class="text-lg font-medium text-gray-800">
                            <%= totalDays %>
                        </p>
                    </div>
                    <div class="bg-gray-50 p-4 rounded-lg shadow-sm">
                        <p class="text-sm text-gray-500">Present Days</p>
                        <p class="text-lg font-medium text-gray-800">
                            <%= presentDays %>
                        </p>
                    </div>
                    <div class="bg-gray-50 p-4 rounded-lg shadow-sm">
                        <p class="text-sm text-gray-500">Absent Days</p>
                        <p class="text-lg font-medium text-gray-800">
                            <%= absentDays %>
                        </p>
                    </div>
                    <div class="bg-gray-50 p-4 rounded-lg shadow-sm">
                        <p class="text-sm text-gray-500">Leave Days</p>
                        <p class="text-lg font-medium text-gray-800">
                            <%= leaveDays %>
                        </p>
                    </div>
                    <div class="bg-gray-50 p-4 rounded-lg shadow-sm">
                        <p class="text-sm text-gray-500">Late Days</p>
                        <p class="text-lg font-medium text-gray-800">
                            <%= lateDays %>
                        </p>
                    </div>
                    <div class="bg-gray-50 p-4 rounded-lg shadow-sm">
                        <p class="text-sm text-gray-500">Attendance Percentage</p>
                        <p class="text-lg font-medium text-gray-800">
                            <%= attendancePercentage %>%
                        </p>
                    </div>
                </div>
            </div>

            <!-- Date Range Filter -->
            <div class="bg-white rounded-xl shadow-lg p-6 mb-8 border border-gray-100">
                <form action="/dashboard/attendance/view/<%= student._id %>" method="GET"
                    class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                    <div class="flex flex-col">
                        <label for="fromDate" class="text-sm font-medium text-gray-600">From Date</label>
                        <input type="date" name="fromDate" value="<%= searchQuery.fromDate %>"
                            class="px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <div class="flex flex-col">
                        <label for="toDate" class="text-sm font-medium text-gray-600">To Date</label>
                        <input type="date" name="toDate" value="<%= searchQuery.toDate %>"
                            class="px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500">
                    </div>
                    <button type="submit"
                        class="self-end px-6 py-2 bg-blue-600 text-white rounded-lg shadow-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        Filter
                    </button>
                </form>
            </div>

            <!-- Daily Attendance Table -->
            <div class="bg-white rounded-xl shadow-lg p-6 border border-gray-100">
                <h3 class="text-xl font-semibold text-gray-800 mb-4">Daily Attendance</h3>
                <div class="overflow-x-auto">
                    <table class="min-w-full table-auto border-collapse">
                        <thead class="bg-gray-50">
                            <tr>
                                <th class="py-3 px-4 text-left text-sm font-medium text-gray-600">Date</th>
                                <th class="py-3 px-4 text-left text-sm font-medium text-gray-600">Class</th>
                                <th class="py-3 px-4 text-left text-sm font-medium text-gray-600">Status</th>
                                <th class="py-3 px-4 text-left text-sm font-medium text-gray-600">Remarks</th>
                            </tr>
                        </thead>
                        <tbody class="text-gray-700">
                            <% attendanceRecords.forEach(attendance=> { %>
                                <tr class="border-b hover:bg-gray-50 transition duration-300">
                                    <td class="py-4 px-4">
                                        <%= attendance.date.toLocaleDateString() %>
                                    </td>
                                    <td class="py-4 px-4">
                                        <%= attendance.classId.name %>
                                    </td>
                                    <td class="py-4 px-4">
                                        <span class="px-2 py-1 rounded-full text-sm font-medium
                                    <%= attendance.status === 'Present' ? 'bg-green-100 text-green-600' :
                                        attendance.status === 'Absent' ? 'bg-red-100 text-red-600' :
                                        attendance.status === 'Late' ? 'bg-yellow-100 text-yellow-600' :
                                        'bg-blue-100 text-blue-600' %>">
                                            <%= attendance.status %>
                                        </span>
                                    </td>
                                    <td class="py-4 px-4">
                                        <%= attendance.remarks || 'N/A' %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                <div class="flex justify-center mt-6">
                    <nav class="inline-flex rounded-md shadow-sm">
                        <% if (currentPage> 1) { %>
                            <a href="/dashboard/attendance/view/<%= student._id %>?page=<%= currentPage - 1 %>&fromDate=<%= searchQuery.fromDate %>&toDate=<%= searchQuery.toDate %>"
                                class="px-4 py-2 bg-white border border-gray-300 rounded-l-md hover:bg-gray-50">
                                Previous
                            </a>
                            <% } %>

                                <% for (let i=1; i <=totalPages; i++) { %>
                                    <a href="/dashboard/attendance/view/<%= student._id %>?page=<%= i %>&fromDate=<%= searchQuery.fromDate %>&toDate=<%= searchQuery.toDate %>"
                                        class="px-4 py-2 border border-gray-300 <%= i === currentPage ? 'bg-blue-500 text-white' : 'bg-white hover:bg-gray-50' %>">
                                        <%= i %>
                                    </a>
                                    <% } %>

                                        <% if (currentPage < totalPages) { %>
                                            <a href="/dashboard/attendance/view/<%= student._id %>?page=<%= currentPage + 1 %>&fromDate=<%= searchQuery.fromDate %>&toDate=<%= searchQuery.toDate %>"
                                                class="px-4 py-2 bg-white border border-gray-300 rounded-r-md hover:bg-gray-50">
                                                Next
                                            </a>
                                            <% } %>
                    </nav>
                </div>

            </div>

            <!-- Back Button -->
            <div class="mt-8">
                <a href="/dashboard/attendance/reports"
                    class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-lg shadow-md transition duration-300 ease-in-out transform hover:scale-105">
                    <i class="fas fa-arrow-left mr-2"></i>Back to Attendance Reports
                </a>
            </div>
    </main>

    <%- include('../../partials/dashboardfooter') %>