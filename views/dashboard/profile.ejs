<%- include('../partials/dashboard') %>

    <main class="flex-grow min-h-screen flex flex-col items-center">
        <!-- Flash Messages -->
        <%- include('../partials/flashMessage') %>

            <!-- Profile Card -->
            <section class="relative w-full max-w-4xl mt-10">
                <div class="relative bg-white dark:bg-gray-800 shadow-xl rounded-3xl p-8 backdrop-blur-lg">
                    <div class="flex flex-col items-center text-center">
                        <!-- Profile Image -->
                        <% if (user.imageUrl) { %>
                            <img src="<%= user.imageUrl %>" alt="Profile Picture"
                                class="w-36 h-36 rounded-full object-cover border-4 border-blue-500 shadow-lg transition-transform hover:scale-105">
                            <% } else { %>
                                <div
                                    class="w-36 h-36 bg-gray-300 rounded-full flex items-center justify-center text-gray-600 text-xl border-4 border-blue-500 shadow-lg">
                                    No Image
                                </div>
                                <% } %>

                                    <h1 class="mt-4 text-3xl font-bold text-gray-900 dark:text-white">
                                        <%= user.name %>
                                    </h1>
                                    <p class="text-lg text-gray-600 dark:text-gray-400 mt-1">
                                        <%= user.address || 'No Address' %>
                                    </p>
                                    <span
                                        class="mt-3 px-4 py-2 text-sm font-semibold text-white bg-blue-600 rounded-lg shadow-md">
                                        <%= user.role || 'No Role' %>
                                    </span>
                    </div>

                    <!-- Profile Info -->
                    <div class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-6 text-left">
                        <% if (user.role==='admin' ) { %>
                            <p class="text-gray-700 dark:text-gray-300"><strong>Admin Since:</strong>
                                <%= user.createdAt.toLocaleDateString() %>
                            </p>
                            <p class="text-gray-700 dark:text-gray-300"><strong>Description:</strong>
                                <%= user.description || 'N/A' %>
                            </p>
                            <% } else if (user.role==='teacher' ) { %>
                                <p class="text-gray-700 dark:text-gray-300"><strong>Subject:</strong>
                                    <%= user.subject || 'N/A' %>
                                </p>
                                <p class="text-gray-700 dark:text-gray-300"><strong>Qualification:</strong>
                                    <%= user.qualification || 'N/A' %>
                                </p>
                                <p class="text-gray-700 dark:text-gray-300"><strong>Salary:</strong> PKR <%= user.salary
                                        || 'N/A' %>
                                </p>
                                <p class="text-gray-700 dark:text-gray-300"><strong>Classes:</strong>
                                    <%= user.classes.map(cls=> cls.name).join(', ') || 'N/A' %>
                                </p>
                                <% } else if (user.role==='student' ) { %>
                                    <p class="text-gray-700 dark:text-gray-300"><strong>Father Name:</strong>
                                        <%= user.fname %>
                                    </p>
                                    <p class="text-gray-700 dark:text-gray-300"><strong>Roll Number:</strong>
                                        <%= user.roll_number %>
                                    </p>
                                    <p class="text-gray-700 dark:text-gray-300"><strong>Class:</strong>
                                        <%= user.stdClass.name || 'N/A' %>
                                    </p>
                                    <p class="text-gray-700 dark:text-gray-300"><strong>Section:</strong>
                                        <%= user.stdClass.section || 'N/A' %>
                                    </p>
                                    <p class="text-gray-700 dark:text-gray-300"><strong>Date of Birth:</strong>
                                        <%= user.dob.toLocaleDateString() %>
                                    </p>
                                    <p class="text-gray-700 dark:text-gray-300"><strong>Enrollment Date:</strong>
                                        <%= user.enrollmentDate.toLocaleDateString() %>
                                    </p>
                                    <% } %>
                    </div>
                </div>
            </section>

    </main>

    <%- include('../partials/dashboardfooter') %>