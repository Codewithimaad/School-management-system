<%- include('../../partials/dashboard') %>

    <main class="flex-grow p-2 md:p-8 lg:p-12 min-h-screen">
        <!-- Flash Messages -->
        <%- include('../../partials/flashMessage') %>

            <!-- Header Section -->
            <header
                class="flex flex-wrap gap-5 items-center justify-between bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-xl shadow-lg px-8 py-6 mb-8">
                <div>
                    <h2 class="text-xl md:text-3xl font-bold tracking-wide">Add Student</h2>
                    <p class="text-sm text-gray-600 dark:text-gray-400">Form for adding a student.</p>
                </div>
                <a href="/dashboard/student/reports"
                    class="bg-blue-600 text-white hover:bg-blue-700 font-semibold px-5 py-2 rounded-lg shadow-md transition duration-300">
                    All Students Reports
                </a>
            </header>

            <!-- Student Form -->
            <section id="student-form">
                <form id="student-form" action="/dashboard/student/add" method="POST"
                    class="bg-white dark:bg-gray-800 p-8 shadow-2xl rounded-2xl w-full mx-auto">

                    <div class="grid md:grid-cols-3 gap-6 mb-6">
                        <!-- Name Input -->
                        <div>
                            <label for="name"
                                class="block text-sm font-medium text-gray-700 dark:text-gray-300">Name</label>
                            <input type="text" id="name" name="name"
                                class="mt-1 block w-full py-3 px-4 bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 dark:focus:ring-blue-400"
                                placeholder="Enter student's Name" />
                        </div>

                        <!-- Father's Name Input -->
                        <div>
                            <label for="fname"
                                class="block text-sm font-medium text-gray-700 dark:text-gray-300">Father's Name</label>
                            <input type="text" id="fname" name="fname"
                                class="mt-1 block w-full py-3 px-4 bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 dark:focus:ring-blue-400"
                                placeholder="Enter father's full name" />
                        </div>

                        <!-- Roll Number Input -->
                        <div>
                            <label for="roll_number"
                                class="block text-sm font-medium text-gray-700 dark:text-gray-300">Roll Number</label>
                            <input type="number" id="roll_number" name="roll_number"
                                class="mt-1 block w-full py-3 px-4 bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 dark:focus:ring-blue-400"
                                placeholder="Enter roll number" />
                        </div>
                    </div>

                    <div class="grid md:grid-cols-3 gap-6 mb-6">
                        <div>
                            <label for="resgistrationNo"
                                class="block text-sm font-medium text-gray-700 dark:text-gray-300">Registration
                                No</label>
                            <input type="text" id="resgistrationNo" name="resgistrationNo"
                                class="mt-1 block w-full py-3 px-4 bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 dark:focus:ring-blue-400"
                                placeholder="Registration no" />
                        </div>

                        <div>
                            <label for="email"
                                class="block text-sm font-medium text-gray-700 dark:text-gray-300">Email</label>
                            <input type="email" id="email" name="email"
                                class="mt-1 block w-full py-3 px-4 bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 dark:focus:ring-blue-400"
                                placeholder="Email" />
                        </div>

                        <div>
                            <label for="password"
                                class="block text-sm font-medium text-gray-700 dark:text-gray-300">Password</label>
                            <input type="password" id="password" name="password"
                                class="mt-1 block w-full py-3 px-4 bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 dark:focus:ring-blue-400"
                                placeholder="Password" />
                        </div>
                    </div>

                    <div class="mb-6">
                        <label for="address"
                            class="block text-sm font-medium text-gray-700 dark:text-gray-300">Address</label>
                        <input type="text" id="address" name="address"
                            class="mt-1 block w-full py-3 px-4 bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white rounded-lg border-gray-300 dark:border-gray-600 shadow-sm focus:border-blue-500 focus:ring focus:ring-blue-200 dark:focus:ring-blue-400"
                            placeholder="Enter student's address" />
                    </div>

                    <!-- Submit Button -->
                    <div class="flex justify-end">
                        <button type="submit"
                            class="px-6 py-3 bg-blue-600 text-white text-sm font-semibold rounded-lg shadow-lg hover:bg-blue-700 transition">
                            Add Student
                        </button>
                    </div>
                </form>
            </section>
    </main>

    <%- include('../../partials/dashboardfooter') %>

        <script src="/javascripts/studentFormValidation.js"></script>