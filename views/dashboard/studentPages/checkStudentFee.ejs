<%- include('../../partials/dashboard') %>

    <main class="flex-grow p-4 md:p-8 lg:p-12 min-h-screen">
        <!-- Header Section -->
        <header
            class="flex flex-col md:flex-row items-center justify-between bg-white dark:bg-gray-800 dark:text-white rounded-xl shadow-lg p-6 mb-8 border border-gray-100 dark:border-gray-700">
            <div class="text-center md:text-left">
                <h2 class="text-3xl font-bold tracking-wide text-gray-800 dark:text-white">Fee Reports</h2>
                <p class="text-sm text-gray-500 dark:text-gray-300 mt-1">An overview of <%= student %> fee reports.</p>
            </div>
        </header>

        <!-- Filter Section -->
        <div
            class="bg-white dark:bg-gray-800 dark:text-white rounded-xl shadow-lg p-6 mb-8 border border-gray-100 dark:border-gray-700">
            <h3 class="text-xl font-semibold text-gray-800 dark:text-white mb-4">Filter Fee Reports</h3>
            <form action="/dashboard/check-fee" method="GET"
                class="flex flex-wrap items-center gap-4 bg-gray-50 dark:bg-gray-700 p-4 rounded-lg shadow-sm border border-gray-100 dark:border-gray-600">
                <div class="flex flex-col">
                    <label class="text-sm font-medium text-gray-600 dark:text-gray-300">Start Date:</label>
                    <input type="date" name="startDate" value="<%= startDate || '' %>"
                        class="border rounded-md px-3 py-2 text-gray-600 dark:text-white dark:bg-gray-700 dark:border-gray-600 focus:ring focus:ring-blue-300">
                </div>
                <div class="flex flex-col">
                    <label class="text-sm font-medium text-gray-600 dark:text-gray-300">End Date:</label>
                    <input type="date" name="endDate" value="<%= endDate || '' %>"
                        class="border rounded-md px-3 py-2 text-gray-600 dark:text-white dark:bg-gray-700 dark:border-gray-600 focus:ring focus:ring-blue-300">
                </div>
                <button type="submit"
                    class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-md transition w-full md:w-auto">Filter</button>
            </form>
        </div>

        <!-- Fee Report Table -->
        <div
            class="max-w-full overflow-x-auto bg-white dark:bg-gray-800 dark:text-white shadow-xl rounded-xl p-4 md:p-8 border border-gray-100 dark:border-gray-700">
            <table class="w-full border-collapse min-w-max">
                <thead class="bg-gray-50 dark:bg-gray-700 text-gray-700 dark:text-white text-xs md:text-sm uppercase">
                    <tr>
                        <th class="py-3 px-4 text-left">Category</th>
                        <th class="py-3 px-4 text-left">Amount</th>
                        <th class="py-3 px-4 text-left">Month</th>
                        <th class="py-3 px-4 text-left">Due Date</th>
                        <th class="py-3 px-4 text-left">Status</th>
                        <th class="py-3 px-4 text-left">Payment Date</th>
                        <th class="py-3 px-4 text-left">Actions</th>
                    </tr>
                </thead>
                <tbody class="text-gray-700 dark:text-white text-xs md:text-sm">
                    <% if (fees.length> 0) { %>
                        <% fees.forEach(fee=> { %>
                            <tr class="border-b hover:bg-gray-50 dark:hover:bg-gray-700 transition duration-300">
                                <td class="py-4 px-4">
                                    <%= fee.category %>
                                </td>
                                <td class="py-4 px-4 font-medium text-green-600 dark:text-green-400">Rs. <%= fee.amount
                                        %>
                                </td>
                                <td class="py-4 px-4">
                                    <%= fee.month %>
                                </td>
                                <td class="py-4 px-4">
                                    <%= new Date(fee.dueDate).toLocaleDateString() %>
                                </td>
                                <td class="py-4 px-4">
                                    <% if (fee.paymentStatus==='Paid' ) { %>
                                        <span
                                            class="bg-green-100 dark:bg-green-600 text-green-600 dark:text-white px-3 py-1 rounded-full text-xs font-semibold">Paid</span>
                                        <% } else { %>
                                            <span
                                                class="bg-red-100 dark:bg-red-600 text-red-600 dark:text-white px-3 py-1 rounded-full text-xs font-semibold">Unpaid</span>
                                            <% } %>
                                </td>
                                <td class="py-4 px-4">
                                    <%= fee.paymentDate ? new Date(fee.paymentDate).toLocaleDateString() : "N/A" %>
                                </td>
                                <td class="py-4 px-4">
                                    <a href="/dashboard/print-fee/<%= fee._id %>"
                                        class="bg-blue-600 hover:bg-blue-700 text-white font-medium px-4 py-2 rounded-md transition">View</a>
                                </td>
                            </tr>
                            <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7" class="text-center py-6 text-gray-500 dark:text-gray-300">No
                                            records found</td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <%- include('../../partials/dashboardfooter') %>