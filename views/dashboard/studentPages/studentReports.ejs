<%- include('../../partials/dashboard') %>

    <main class="flex-grow p-4 md:p-8 lg:p-12 bg-gray-100">
        <!-- Flash Messages -->
        <%- include('../../partials/flashMessage') %>

            <!-- Header Section -->
            <header
                class="flex flex-wrap gap-5 items-center justify-between bg-white text-gray-800 rounded-xl shadow-lg px-8 py-6 mb-8">
                <div>
                    <h2 class="text-3xl font-bold tracking-wide">Student Reports</h2>
                    <p class="text-sm lg:block hidden opacity-90">An overview of all enrolled students.</p>
                </div>
                <a href="/dashboard/student/add"
                    class="bg-gray-100 text-blue-700 hover:bg-gray-200 font-semibold px-6 py-3 rounded-lg shadow-md transition duration-300">
                    + Add Student
                </a>
            </header>

            <!-- Search Section -->
            <div class="flex flex-wrap items-center justify-between w-full bg-white p-6 rounded-lg shadow-md">
                <form action="/dashboard/student/reports" method="GET" class="flex flex-wrap gap-3 w-full sm:w-2/3">
                    <input type="text" name="search" id="search" value="<%= searchQuery.name %>"
                        placeholder="Search students by name..."
                        class="px-4 py-3 w-full sm:w-1/3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring focus:ring-blue-500">
                    <select name="stdClass" id="stdClass"
                        class="px-4 py-3 w-full sm:w-1/3 border border-gray-300 rounded-lg shadow-sm focus:outline-none focus:ring focus:ring-blue-500">
                        <option value="">Select Class</option>
                        <% classes.forEach(classItem=> { %>
                            <option value="<%= classItem._id %>" <%=searchQuery.stdClass &&
                                searchQuery.stdClass.toString()===classItem._id.toString() ? 'selected' : '' %> >
                                <%= classItem.name %>
                            </option>
                            <% }) %>
                    </select>
                    <button type="submit"
                        class="text-white py-3 px-6 bg-green-600 rounded-lg shadow-md hover:bg-green-700 transition duration-200">
                        <i class="fas fa-search mr-2"></i> Search
                    </button>
                </form>
            </div>

            <!-- Student Table Section -->
            <section class="mt-6 bg-white p-2 md:p-6 rounded-lg shadow-md">
                <p class="text-lg font-semibold text-gray-700 mb-4">Total Students: <span class="text-blue-600">
                        <%= totalStudents %>
                    </span></p>
                <div class="overflow-x-auto">
                    <table class="w-full border-collapse rounded-md overflow-hidden shadow-md">
                        <thead class="bg-blue-500 text-white">
                            <tr>
                                <th class="p-4 text-left">Name</th>
                                <th class="p-4 text-left">Father's Name</th>
                                <th class="p-4 text-left">Roll No</th>
                                <th class="p-4 text-left">Phone</th>
                                <th class="p-4 text-left">DOB</th>
                                <th class="p-4 text-left">Gender</th>
                                <th class="p-4 text-left">Class</th>
                                <th class="p-4 text-left">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% students.forEach(student=> { %>
                                <tr class="border-b hover:bg-gray-100 transition">
                                    <td class="p-4">
                                        <%= student.name %>
                                    </td>
                                    <td class="p-4">
                                        <%= student.fname %>
                                    </td>
                                    <td class="p-4">
                                        <%= student.roll_number %>
                                    </td>
                                    <td class="p-4">
                                        <%= student.phone %>
                                    </td>
                                    <td class="p-4">
                                        <%= new Date(student.dob).toLocaleDateString() %>
                                    </td>
                                    <td class="p-4">
                                        <%= student.gender || 'N/A' %>
                                    </td>
                                    <td class="p-4">
                                        <%= student.stdClass ? student.stdClass.name : 'N/A' %>
                                    </td>
                                    <td class="p-4 flex gap-2">
                                        <a href="/dashboard/student/details/<%= student._id %>"
                                            class="text-white bg-blue-600 px-4 py-2 rounded hover:bg-blue-700">Details</a>
                                        <a href="/dashboard/student/edit/<%= student._id %>"
                                            class="bg-yellow-500 text-white px-4 py-2 rounded hover:bg-yellow-600">Edit</a>
                                        <button
                                            class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600 delete-btn"
                                            data-id="<%= student._id %>">Delete</button>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Pagination Section -->
            <section class="mt-6 flex flex-wrap gap-5 justify-between items-center">
                <div class="text-sm text-gray-600">
                    Showing <%= (currentPage - 1) * 10 + 1 %> to <%= currentPage * 10 < totalStudents ? currentPage * 10
                            : totalStudents %> of <%= totalStudents %> students
                </div>
                <div class="flex gap-2">
                    <button onclick="location.href='/dashboard/student/reports?page=<%= currentPage - 1 %>'"
                        class="px-4 py-2 text-white rounded-lg shadow-md <%= currentPage === 1 ? 'bg-gray-400 cursor-not-allowed' : 'bg-blue-600 hover:bg-blue-700' %>">
                        Previous
                    </button>
                    <% for (let i=1; i <=totalPages; i++) { %>
                        <a href="/dashboard/student/reports?page=<%= i %>"
                            class="px-4 py-2 rounded-lg <%= currentPage === i ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-700' %>">
                            <%= i %>
                        </a>
                        <% } %>
                            <button onclick="location.href='/dashboard/student/reports?page=<%= currentPage + 1 %>'"
                                class="px-4 py-2 text-white rounded-lg shadow-md <%= currentPage === totalPages ? 'bg-gray-400 cursor-not-allowed' : 'bg-blue-600 hover:bg-blue-700' %>">
                                Next
                            </button>
                </div>
            </section>
    </main>

    <%- include('../../partials/dashboardfooter') %>


        <!-- Role-Based Visibility Script -->
        <script>
            // Example User Role (e.g., fetched from server or session)
            const userRole = "teacher"; // Change to "admin", "student", etc., to test

            // Show links based on role
            document.querySelectorAll(`.role-${userRole}`).forEach(el => {
                el.classList.remove("hidden");
            });
        </script>

        <script>
            document.querySelectorAll('.delete-btn').forEach(button => {
                button.addEventListener('click', function (e) {
                    e.preventDefault();
                    const deleteID = this.dataset.id;

                    Swal.fire({
                        title: 'Are you sure?',
                        text: "This action cannot be undone.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonText: 'Yes, delete it!',
                        cancelButtonText: 'No, cancel',
                        reverseButtons: true
                    }).then(result => {
                        if (result.isConfirmed) {
                            fetch(`/dashboard/student/delete/${deleteID}`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ id: deleteID })
                            })
                                .then(response => response.ok ? Swal.fire('Deleted!', 'Student record deleted.', 'success')
                                    .then(() => window.location.href = '/dashboard/student/reports')
                                    : Swal.fire('Error', 'Failed to delete record.', 'error'))
                                .catch(() => Swal.fire('Error', 'Request failed.', 'error'));
                        }
                    });
                });
            });
        </script>