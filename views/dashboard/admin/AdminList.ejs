<%- include('../../partials/dashboard') %>

    <main class="flex-grow p-4 md:p-8 lg:p-12">

        <%- include('../../partials/flashMessage') %>

            <!-- Header -->
            <header
                class="flex flex-wrap gap-5 items-start sm:items-center justify-between border-b pb-6 mb-8 text-gray-800 rounded-lg bg-white shadow-2xl px-6 md:px-8 py-6">
                <div>
                    <h2 class="text-base md:text-lg font-bold tracking-wide">All Admins</h2>
                    <p class="text-sm text-gray-500">List of all registered admins.</p>
                </div>
                <div class="mt-4 sm:mt-0">
                    <a href="/dashboard/admin/add"
                        class="inline-block bg-gray-100 text-blue-600 font-semibold py-2 px-4 md:px-6 rounded-lg shadow-md hover:bg-gray-200 hover:shadow-lg transition-all duration-300">
                        Add new Admin
                    </a>
                </div>
            </header>

            <!-- Admin Cards Grid -->
            <section id="admin-cards" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                <% admins.forEach(admin=> { %>
                    <div
                        class="bg-white shadow-lg rounded-xl overflow-hidden transform transition-all hover:scale-105 duration-300 hover:shadow-2xl">

                        <!-- Admin Image Section -->
                        <div class="relative">
                            <% if (admin.imageUrl===null && admin.gender==='Male' ){ %>
                                <img src="/images/Male logo.png" alt="Admin Image"
                                    class="w-full h-72 object-cover rounded-t-xl">
                                <% } else if (admin.imageUrl===null && admin.gender==='Female' ){ %>
                                    <img src="/images/Female logo.jpg" alt="Admin Image"
                                        class="w-full h-72 object-cover rounded-t-xl">
                                    <% } else { %>
                                        <img src="<%= admin.imageUrl %>" alt="Admin Image"
                                            class="w-full h-72 object-cover rounded-t-xl">
                                        <% } %>

                                            <!-- Gradient Overlay -->
                                            <div
                                                class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black to-transparent p-4">
                                                <h3 class="text-xl font-semibold text-white text-shadow-md mb-2">
                                                    <%= admin.name %>
                                                </h3>
                                                <p class="text-sm text-white opacity-80">
                                                    <%= admin.email %>
                                                </p>
                                            </div>
                        </div>

                        <!-- Admin Info Section -->
                        <div class="px-6 py-4 space-y-4">
                            <!-- Description -->
                            <div class="flex justify-between items-center">
                                <span class="text-gray-500 text-sm">Description</span>
                                <p class="text-sm font-semibold text-gray-700 line-clamp-2">
                                    <%= admin.description || 'No description provided.' %>
                                </p>
                            </div>
                        </div>

                        <!-- Admin Actions Section -->
                        <div class="bg-gray-50 p-4 flex justify-between items-center border-t border-gray-100">
                            <a href="/dashboard/admin/edit/<%= admin._id %>"
                                class="text-indigo-600 hover:text-indigo-800 font-semibold transition duration-300 flex items-center">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                    xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z">
                                    </path>
                                </svg>
                                Edit
                            </a>
                            <!-- Delete Button with SweetAlert confirmation -->
                            <button
                                class="text-red-600 hover:text-red-800 font-semibold transition duration-300 flex items-center delete-btn"
                                data-id="<%= admin._id %>">
                                <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"
                                    xmlns="http://www.w3.org/2000/svg">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                    </path>
                                </svg>
                                Delete
                            </button>
                        </div>
                    </div>
                    <% }) %>
            </section>

    </main>

    <!-- SweetAlert -->
    <script>
        // SweetAlert2 script for delete confirmation
        document.querySelectorAll('.delete-btn').forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                const deleteID = this.getAttribute('data-id');

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, delete it!',
                    cancelButtonText: 'No, keep it',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        Swal.fire({
                            title: "Deleted!",
                            text: "The admin has been deleted.",
                            icon: "success"
                        });
                        // Redirect to delete route if confirmed
                        window.location.href = `/dashboard/admin/delete/${deleteID}`;
                    }
                });
            });
        });
    </script>

    <%- include('../../partials/dashboardfooter') %>