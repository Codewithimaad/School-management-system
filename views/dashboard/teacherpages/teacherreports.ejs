<%- include('../../partials/dashboard') %>

    <main class="flex-grow p-2 md:p-6 lg:p-10">
        <%- include('../../partials/flashMessage') %>

            <!-- Header Section -->
            <header
                class="flex flex-wrap items-center justify-between bg-white dark:bg-gray-800 text-gray-800 dark:text-white rounded-lg shadow-lg p-6 mb-8">
                <div>
                    <h2 class="text-base md:text-3xl font-bold">All Teachers</h2>
                    <p class="text-sm opacity-80">List of all registered teachers.</p>
                </div>
                <a href="/dashboard/teacher/add"
                    class="bg-gray=100 dark:bg-gray-700 text-gray-600 dark:text-white hover:bg-gray-200 dark:hover:bg-gray-600 font-semibold px-5 py-2 rounded-lg shadow-md transition duration-300">
                    + Add Teacher
                </a>
            </header>

            <!-- Teacher Reports Overview -->
            <section class="mb-8">
                <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6">
                    <div class="p-6 bg-white dark:bg-gray-800 rounded-xl shadow-lg border-l-4 border-blue-500">
                        <h3 class="font-medium text-gray-600 dark:text-white">Total Teachers</h3>
                        <p class="text-3xl font-bold text-blue-600">
                            <%= totalTeachers %>
                        </p>
                    </div>
                    <div class="p-6 bg-white dark:bg-gray-800 rounded-xl shadow-lg border-l-4 border-green-500">
                        <h3 class="font-medium text-gray-600 dark:text-white">Active Teachers</h3>
                        <p class="text-3xl font-bold text-green-600">
                            <%= activeTeachers %>
                        </p>
                    </div>
                    <div class="p-6 bg-white dark:bg-gray-800 rounded-xl shadow-lg border-l-4 border-yellow-500">
                        <h3 class="font-medium text-gray-600 dark:text-white">Teachers on Leave</h3>
                        <p class="text-3xl font-bold text-yellow-500">
                            <%= teachersOnLeave %>
                        </p>
                    </div>
                </div>
            </section>

            <!-- Teacher List -->
            <section class="bg-white dark:bg-gray-800 rounded-lg shadow-lg">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-gray-200 dark:bg-gray-700 text-gray-700 dark:text-white">
                                <th class="p-4">Name</th>
                                <th class="p-4">Subject</th>
                                <th class="p-4">Qualification</th>
                                <th class="p-4">Status</th>
                                <th class="p-4">Email</th>
                                <th class="p-4">Phone No</th>
                                <th class="p-4">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% teachers.forEach(teacher=> { %>
                                <tr class="border-b hover:bg-gray-100 dark:hover:bg-gray-700 transition">
                                    <td class="p-4 font-medium text-gray-800 dark:text-white">
                                        <%= teacher.name %>
                                    </td>
                                    <td class="p-4 text-gray-600 dark:text-white">
                                        <%= teacher.subject %>
                                    </td>
                                    <td class="p-4 text-gray-600 dark:text-white">
                                        <%= teacher.qualification %>
                                    </td>
                                    <td
                                        class="p-4 font-semibold <%= teacher.status === 'Active' ? 'text-green-600' : 'text-red-600' %>">
                                        <%= teacher.status %>
                                    </td>
                                    <td class="p-4 text-gray-600 dark:text-white">
                                        <%= teacher.email %>
                                    </td>
                                    <td class="p-4 text-gray-600 dark:text-white">
                                        <%= teacher.phone %>
                                    </td>
                                    <td class="p-4 flex space-x-2">
                                        <a href="/dashboard/teacher/<%= teacher._id %>"
                                            class="text-white px-3 py-2 bg-blue-600 rounded-md shadow hover:bg-blue-800">Details</a>
                                        <a href="/dashboard/teacher/edit/<%= teacher._id %>"
                                            class="text-white px-3 py-2 bg-yellow-500 rounded-md shadow hover:bg-yellow-700">Edit</a>
                                        <button
                                            class="text-white px-3 py-2 bg-red-600 rounded-md shadow hover:bg-red-800 delete-btn"
                                            data-id="<%= teacher._id %>">Delete</button>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>
    </main>

    <script>
        document.querySelectorAll('.delete-btn').forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                const deleteID = this.getAttribute('data-id');
                Swal.fire({
                    title: 'Are you sure?',
                    text: "This action cannot be undone!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, delete',
                    cancelButtonText: 'Cancel',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        fetch(`/dashboard/teacher/delete/${deleteID}`, { method: 'GET' })
                            .then(response => response.ok ? Swal.fire('Deleted!', 'The teacher has been removed.', 'success') : Swal.fire('Error', 'Failed to delete teacher.', 'error'))
                            .then(() => location.reload());
                    }
                });
            });
        });
    </script>

    <%- include('../../partials/dashboardfooter') %>