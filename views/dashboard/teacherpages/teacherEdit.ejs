<%- include('../../partials/dashboard') %>

    <main class="flex-grow p-4 md:p-8 lg:p-12 ">


        <!-- Header Section -->
        <header class="flex items-center justify-between bg-white text-gray-900 rounded-lg shadow-xl px-8 py-6 mb-8">
            <div>
                <h2 class="text-3xl font-bold tracking-wide">Update Teacher</h2>
            </div>
            <a href="/dashboard/teacher/reports"
                class="bg-gray-100 text-gray-800 hover:bg-gray-200 font-semibold px-4 py-2 rounded-md shadow-md transition duration-300">
                Back to Reports
            </a>
        </header>

        <!-- Form Section -->
        <section class="bg-white shadow-2xl rounded-2xl p-8 border border-gray-100">
            <form action="/dashboard/teacher/edit/<%= teachers._id %>" method="post" enctype="multipart/form-data">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                    <!-- Left Column -->
                    <div class="space-y-6">
                        <!-- Full Name -->
                        <div>
                            <label for="name" class="block text-sm font-medium text-gray-700 mb-1">Full Name</label>
                            <input type="text" name="name" value="<%= teachers.name %>" required
                                class="w-full bg-gray-100  px-4 py-2.5 rounded-lg shadow-sm transition-all duration-300 focus:ring-1 focus:ring-blue-300 focus:outline-none">
                        </div>

                        <!-- Subject -->
                        <div>
                            <label for="subject" class="block text-sm font-medium text-gray-700 mb-1">Subject</label>
                            <input type="text" name="subject" value="<%= teachers.subject %>" required
                                class="w-full bg-gray-100  px-4 py-2.5 rounded-lg shadow-sm transition-all duration-300 focus:ring-1 focus:ring-blue-300 focus:outline-none">
                        </div>

                        <!-- Qualification -->
                        <div>
                            <label for="qualification"
                                class="block text-sm font-medium text-gray-700 mb-1">Qualification</label>
                            <input type="text" name="qualification" value="<%= teachers.qualification %>" required
                                class="w-full bg-gray-100  px-4 py-2.5 rounded-lg shadow-sm transition-all duration-300 focus:ring-1 focus:ring-blue-300 focus:outline-none">
                        </div>

                        <!-- Email -->
                        <div>
                            <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
                            <input type="email" name="email" value="<%= teachers.email %>" required
                                class="w-full bg-gray-100  px-4 py-2.5 rounded-lg shadow-sm transition-all duration-300 focus:ring-1 focus:ring-blue-300 focus:outline-none">
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div class="space-y-6">
                        <!-- Phone -->
                        <div>
                            <label for="phone" class="block text-sm font-medium text-gray-700 mb-1">Phone</label>
                            <input type="tel" name="phone" value="<%= teachers.phone %>" required
                                class="w-full bg-gray-100  px-4 py-2.5 rounded-lg shadow-sm transition-all duration-300 focus:ring-1 focus:ring-blue-300 focus:outline-none">
                        </div>

                        <!-- Status -->
                        <div>
                            <label for="status" class="block text-sm font-medium text-gray-700 mb-1">Status</label>
                            <select name="status" required
                                class="w-full bg-gray-100 px-4 py-2.5 rounded-lg shadow-sm focus:ring-1 focus:ring-blue-300 focus:outline-none transition-all duration-300">
                                <option value="Active" <%=teachers.status==='Active' ? 'selected' : '' %>>Active
                                </option>
                                <option value="Inactive" <%=teachers.status==='Inactive' ? 'selected' : '' %>>Inactive
                                </option>
                            </select>
                        </div>

                        <!-- Gender -->
                        <div>
                            <label for="gender" class="block text-sm font-medium text-gray-700 mb-1">Gender</label>
                            <select name="gender" required
                                class="w-full bg-gray-100 px-4 py-2.5 rounded-lg shadow-sm focus:ring-1 focus:ring-blue-300 focus:outline-none transition-all duration-300">
                                <option value="Male" <%=teachers.gender==='Male' ? 'selected' : '' %>>Male</option>
                                <option value="Female" <%=teachers.gender==='Female' ? 'selected' : '' %>>Female
                                </option>
                            </select>
                        </div>

                        <!-- Salary -->
                        <div>
                            <label for="salary" class="block text-sm font-medium text-gray-700 mb-1">Salary</label>
                            <input type="number" name="salary" value="<%= teachers.salary %>" required
                                class="w-full bg-gray-100  px-4 py-2.5 rounded-lg shadow-sm transition-all duration-300 focus:ring-1 focus:ring-blue-300 focus:outline-none">
                        </div>
                    </div>
                </div>

                <!-- Description -->
                <div class="mt-8">
                    <label for="description" class="block text-sm font-medium text-gray-700 mb-1">Description</label>
                    <textarea name="description" rows="5" required
                        class="w-full bg-gray-100 px-4 py-2.5 border border-gray-300 rounded-lg shadow-sm focus:ring-1 focus:ring-blue-300 focus:outline-none transition-all duration-300"><%= teachers.description || '' %></textarea>
                </div>

                <!-- Image Display and Upload Section -->
                <div class="mt-8">
                    <label class="block text-sm font-medium text-gray-700 mb-2">Current Image</label>
                    <% if (teachers.imageUrl) { %>
                        <div class="mb-4">
                            <img src="<%= teachers.imageUrl %>" alt="Teacher Image"
                                class="w-32 h-32 object-cover rounded-full border-4 border-indigo-600 shadow-md">
                        </div>
                        <% } else { %>
                            <p class="text-sm text-gray-500">No image available.</p>
                            <% } %>

                                <input type="hidden" name="image" value="<%= teachers.imageUrl %>" />

                                <label for="image" class="block text-sm font-medium text-gray-700 mt-4">Upload New Image
                                    (Optional)</label>
                                <input type="file" name="image"
                                    class="w-full bg-gray-100 px-4 py-2.5 rounded-lg shadow-sm focus:ring-1 focus:ring-blue-300 focus:outline-none transition-all duration-300">
                </div>

                <!-- Submit Button -->
                <div class="mt-8 flex justify-end">
                    <button type="submit"
                        class="px-8 py-3 bg-gradient-to-r from-indigo-600 to-purple-600 text-white rounded-xl shadow-md hover:shadow-lg transition-all duration-300 transform hover:scale-105 font-medium">
                        Update
                    </button>
                </div>
            </form>
        </section>
    </main>

    <%- include('../../partials/dashboardfooter') %>