<%- include('../../partials/dashboard') %>

    <main class="flex-grow p-2 md:p-8 lg:p-12">
        <!-- Header Section -->
        <header
            class="flex flex-wrap gap-5 items-center justify-between bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg shadow-xl px-8 py-6 mb-8">
            <div>
                <h2 class="text-base md:text-3xl font-bold tracking-wide">Update Class</h2>
                <p class="text-sm dark:text-gray-300">Fill out the form below to Update the Class.</p>
            </div>
            <a href="/dashboard/class/reports"
                class="bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 text-sm md:text-base hover:bg-gray-200 dark:hover:bg-gray-600 font-semibold px-4 py-2 rounded-md shadow-md transition duration-300">
                Back to all Classes
            </a>
        </header>

        <%- include('../../partials/flashMessage') %>

            <!-- Class Form Section -->
            <section class="bg-white dark:bg-gray-800 shadow-2xl rounded-lg p-6 md:p-12">
                <form action="/dashboard/class/edit/<%= classItem._id %>" method="POST">
                    <div class="mb-4">
                        <label for="name" class="block text-sm font-semibold text-gray-700 dark:text-gray-300">Class
                            Name</label>
                        <input type="text" id="name" name="name" value="<%= classItem.name %>"
                            class="px-4 py-2 bg-gray-100 dark:bg-gray-700 dark:text-white w-full rounded-lg focus:outline-none focus:ring-1 focus:ring-blue-300"
                            required>
                    </div>

                    <div class="mb-4">
                        <label for="section"
                            class="block text-sm font-semibold text-gray-700 dark:text-gray-300">Section</label>
                        <select id="section" name="section"
                            class="px-4 py-2 bg-gray-100 dark:bg-gray-700 dark:text-white w-full rounded-lg focus:outline-none focus:ring-1 focus:ring-blue-300"
                            required>
                            <option value="A" <%=classItem.section==='A' ? 'selected' : '' %>>A</option>
                            <option value="B" <%=classItem.section==='B' ? 'selected' : '' %>>B</option>
                        </select>
                    </div>

                    <div class="mb-4 flex items-center justify-between">
                        <button type="submit"
                            class="px-6 py-2 bg-blue-800 text-white rounded-lg shadow hover:bg-blue-700 focus:ring focus:ring-blue-200 focus:outline-none">
                            Update Class
                        </button>
                    </div>
                </form>
            </section>
    </main>

    <%- include('../../partials/dashboardfooter') %>