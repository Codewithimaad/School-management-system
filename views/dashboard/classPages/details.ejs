<%- include('../../partials/dashboard') %>

    <div class="flex-grow p-4 md:p-8 lg:p-12">
        <!-- Header Section -->
        <header
            class="flex flex-wrap gap-5 items-center justify-between bg-white dark:bg-gray-800 text-gray-900 dark:text-white rounded-lg shadow-xl px-8 py-6 mb-8">
            <div>
                <h2 class="text-base md:text-3xl font-bold tracking-wide">Class Details: <%= classItem.name %>
                </h2>
            </div>
            <a href="/dashboard/class/reports"
                class="bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-200 text-sm md:text-base hover:bg-gray-200 dark:hover:bg-gray-600 font-semibold px-4 py-2 rounded-md shadow-md transition duration-300">
                Back to all Classes
            </a>
        </header>

        <!-- Class Information Section -->
        <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-2xl mb-8">
            <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Class Information</h2>
            <p class="text-lg font-bold text-gray-700 dark:text-gray-300">Section: <span class="font-semibold">
                    <%= classItem.section %>
                </span></p>
            <p class="text-lg font-bold text-gray-700 dark:text-gray-300">Total Students: <span class="font-semibold">
                    <%= classItem.students.length %>
                </span></p>
        </div>

        <!-- Students Table Section -->
        <div class="bg-white dark:bg-gray-800 p-6 rounded-lg shadow-2xl mb-8">
            <h2 class="text-2xl font-semibold text-gray-900 dark:text-white mb-4">Students</h2>
            <div class="overflow-x-auto">
                <table class="min-w-full table-auto">
                    <thead>
                        <tr class="bg-gray-100 dark:bg-gray-700 text-left">
                            <th class="px-4 py-3 text-sm font-semibold text-gray-700 dark:text-gray-300">Roll No</th>
                            <th class="px-4 py-3 text-sm font-semibold text-gray-700 dark:text-gray-300">Name</th>
                            <th class="px-4 py-3 text-sm font-semibold text-gray-700 dark:text-gray-300">F Name</th>
                            <th class="px-4 py-3 text-sm font-semibold text-gray-700 dark:text-gray-300">Email</th>
                            <th class="px-4 py-3 text-sm font-semibold text-gray-700 dark:text-gray-300">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% classItem.students.forEach(student=> { %>
                            <tr class="border-b hover:bg-gray-50 dark:hover:bg-gray-700">
                                <td class="px-4 py-4 text-sm text-gray-700 dark:text-gray-300">
                                    <%= student.roll_number %>
                                </td>
                                <td class="px-4 py-4 text-sm font-medium text-gray-800 dark:text-gray-200">
                                    <%= student.name %>
                                </td>
                                <td class="px-4 py-4 text-sm font-medium text-gray-800 dark:text-gray-200">
                                    <%= student.fname %>
                                </td>
                                <td class="px-4 py-4 text-sm text-gray-700 dark:text-gray-300">
                                    <%= student.email %>
                                </td>
                                <td class="px-4 py-4 text-sm text-gray-700 dark:text-gray-300">
                                    <a class="bg-green-600 px-3 py-2 text-white rounded hover:bg-green-900"
                                        href="/dashboard/student/details/<%= student._id %>">Details</a>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Back Button -->
        <a href="/dashboard/class/reports"
            class="mt-4 inline-block bg-blue-800 text-white py-3 px-6 rounded-lg shadow-md hover:bg-blue-900 transition duration-200">
            Back to Class Reports
        </a>
    </div>

    <%- include('../../partials/dashboardfooter') %>