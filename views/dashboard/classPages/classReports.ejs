<%- include('../../partials/dashboard') %>

    <main class="flex-grow p-6 md:p-10 lg:p-14 bg-gray-50">
        <!-- Header Section -->
        <header
            class="flex flex-wrap items-center justify-between bg-gradient-to-r from-blue-700 to-blue-900 text-white rounded-2xl shadow-xl px-8 py-6 mb-8">
            <div>
                <h2 class="text-lg lg:text-3xl font-extrabold tracking-wide">Class Reports</h2>
                <p class="text-sm opacity-80 lg:block ">Overview of all classes with student details.
                </p>
            </div>
            <a href="/dashboard/class/add"
                class="bg-white text-blue-700 hover:bg-gray-100 font-semibold px-4 lg:px-6 py-2 lg:py-3 rounded-lg shadow-md transition-all duration-300 mt-4">
                + Add Class
            </a>
        </header>

        <%- include('../../partials/flashMessage') %>

            <!-- Class Table -->
            <section class="bg-white shadow-xl rounded-2xl p-6 overflow-hidden">
                <div class="overflow-x-auto">
                    <table class="w-full table-auto border-collapse">
                        <thead>
                            <tr class="bg-gray-100 text-left text-gray-700">
                                <th class="px-6 py-4 text-sm font-semibold">Class Name</th>
                                <th class="px-6 py-4 text-sm font-semibold">Section</th>
                                <th class="px-6 py-4 text-sm font-semibold">Students</th>
                                <th class="px-6 py-4 text-sm font-semibold">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% classes.forEach(classItem=> { %>
                                <tr class="border-b hover:bg-gray-50 transition-all">
                                    <td class="px-6 py-4 text-sm font-medium text-gray-800">
                                        <%= classItem.name %>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-700">
                                        <%= classItem.section %>
                                    </td>
                                    <td class="px-6 py-4 text-sm text-gray-700">
                                        <%= classItem.students ? classItem.students.length : 0 %>
                                    </td>
                                    <td class="px-6 py-4 flex items-center space-x-3 text-sm">
                                        <a href="/dashboard/class/edit/<%= classItem._id %>"
                                            class="bg-green-500 text-white px-4 py-2 rounded-lg hover:bg-green-600 transition-all">
                                            Edit
                                        </a>
                                        <button
                                            class="bg-red-500 text-white px-4 py-2 rounded-lg hover:bg-red-600 transition-all delete-btn"
                                            data-id="<%= classItem._id %>">
                                            Delete
                                        </button>
                                        <a href="/dashboard/class/details/<%= classItem._id %>"
                                            class="bg-blue-500 text-white px-4 py-2 rounded-lg hover:bg-blue-600 transition-all">
                                            Details
                                        </a>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Pagination -->
            <section class="flex flex-col sm:flex-row sm:items-center sm:justify-between mt-6 p-6 gap-4">
                <div class="text-sm text-gray-500">
                    Showing <%= (currentPage - 1) * 8 + 1 %> to <%= Math.min(currentPage * 8, totalClasses) %> of <%=
                                totalClasses %> classes
                </div>
                <div class="flex gap-2">
                    <% if (currentPage> 1) { %>
                        <a href="/dashboard/class/reports?page=<%= currentPage - 1 %>"
                            class="px-4 py-2 text-sm bg-blue-700 text-white rounded-lg shadow-md hover:bg-blue-600 transition-all">
                            Previous
                        </a>
                        <% } %>
                            <% for (let i=1; i <=totalPages; i++) { %>
                                <a href="/dashboard/class/reports?page=<%= i %>"
                                    class="px-4 py-2 text-sm rounded-lg shadow-md transition-all <%= currentPage === i ? 'bg-blue-700 text-white' : 'bg-gray-200 text-gray-800 hover:bg-gray-300' %>">
                                    <%= i %>
                                </a>
                                <% } %>
                                    <% if (currentPage < totalPages) { %>
                                        <a href="/dashboard/class/reports?page=<%= currentPage + 1 %>"
                                            class="px-4 py-2 text-sm bg-blue-700 text-white rounded-lg shadow-md hover:bg-blue-600 transition-all">
                                            Next
                                        </a>
                                        <% } %>
                </div>
            </section>
    </main>

    <script>
        document.querySelectorAll('.delete-btn').forEach(button => {
            button.addEventListener('click', function (e) {
                e.preventDefault();
                const deleteID = this.getAttribute('data-id');

                Swal.fire({
                    title: 'Are you sure?',
                    text: "You won't be able to revert this!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: 'Yes, delete it!',
                    cancelButtonText: 'No, keep it',
                    reverseButtons: true
                }).then((result) => {
                    if (result.isConfirmed) {
                        fetch(`/dashboard/class/delete/${deleteID}`, { method: 'GET' })
                            .then(response => {
                                if (response.ok) {
                                    Swal.fire({
                                        title: "Deleted!",
                                        text: "The class has been deleted.",
                                        icon: "success"
                                    }).then(() => {
                                        window.location.href = '/dashboard/class/reports';
                                    });
                                } else {
                                    Swal.fire({ title: "Error", text: "There was an issue deleting the class.", icon: "error" });
                                }
                            })
                            .catch(err => {
                                console.error(err);
                                Swal.fire({ title: "Error", text: "Failed to delete the class.", icon: "error" });
                            });
                    }
                });
            });
        });
    </script>

    <%- include('../../partials/dashboardfooter') %>